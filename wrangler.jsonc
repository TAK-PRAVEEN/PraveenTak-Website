{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "praveen-tak-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},
	// Workers AI powers /api/chat. It needs a Cloudflare login (wrangler always runs AI
	// remotely), so it is switched on at deploy time — see DESIGN.md §14. Until then
	// the chatbot answers from its scripted fallback.
	// "ai": { "binding": "AI" },
	"observability": {
		"enabled": true
	}
}