---
/**
 * TEMPORARY review tool: switch the candidate home sections (variants 1–4) on
 * and off to compare combinations. Selection lives in the URL (?s=1,2) and is
 * remembered locally. Remove this (and the unused variants) once Praveen picks.
 */
const variants = [
  { n: "1", label: "Ink drains" },
  { n: "2", label: "Loss curve" },
  { n: "3", label: "Toolkit wall" },
  { n: "4", label: "How I work" },
];
---

<div class="picker" data-picker role="group" aria-label="Preview home sections">
  <span class="micro picker-title">Sections</span>
  {
    variants.map((v) => (
      <label class="picker-opt micro">
        <input type="checkbox" value={v.n} data-pick />
        <span>{v.n}</span>
        <span class="picker-name">{v.label}</span>
      </label>
    ))
  }
</div>

<script>
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const KEY = "pt-home-sections";
  const read = () => {
    const q = new URLSearchParams(location.search).get("s");
    let saved: string | null = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {}
    return (q ?? saved ?? "1,2").split(",").filter(Boolean);
  };
  const apply = (on: string[]) => {
    document.querySelectorAll<HTMLElement>("[data-variant]").forEach((el) => (el.hidden = !on.includes(el.dataset.variant!)));
    document.querySelectorAll<HTMLInputElement>("[data-pick]").forEach((c) => (c.checked = on.includes(c.value)));
    try {
      localStorage.setItem(KEY, on.join(","));
    } catch {}
    const url = new URL(location.href);
    url.searchParams.set("s", on.join(","));
    history.replaceState(history.state, "", url);
    ScrollTrigger.refresh();
  };
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-picker]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    apply(read());
    root.addEventListener("change", () => {
      apply(Array.from(root.querySelectorAll<HTMLInputElement>("[data-pick]:checked")).map((c) => c.value));
    });
  });
</script>

<style>
  .picker {
    position: fixed;
    right: 16px;
    bottom: 84px;
    z-index: 60;
    display: grid;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 14px;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.4);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .picker-title {
    color: var(--fg-muted);
    margin-bottom: 2px;
  }
  .picker-opt {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .picker-opt input {
    accent-color: var(--accent);
    margin: 0;
  }
  .picker-name {
    color: var(--fg-muted);
  }
  @media (max-width: 600px) {
    .picker-name {
      display: none;
    }
  }
</style>
