---
/**
 * Variant 4 — How I work (pinned).
 * The section sticks while four principles swap through one at a time with a
 * scramble-text change; a progress line fills as you go.
 * DRAFT COPY: the principles below are placeholders for Praveen to rewrite.
 */
const principles = [
  { title: "Start from the data.", note: "Before any model: what do the records actually say, and what is missing?" },
  { title: "Measure before claiming.", note: "Controlled runs, fixed validation sets, numbers that can be checked." },
  { title: "Ship to real people.", note: "Field apps, ERPs and websites that are used every day, not demos." },
  { title: "Make it feel alive.", note: "Motion, sound and detail, so the system is a pleasure to use." },
];
---

<section class="how" data-variant="4" data-how aria-labelledby="how-title">
  <div class="how-sticky frame">
    <div class="how-head micro">
      <h2 id="how-title" data-decode>01.5 — How I work</h2>
      <span class="hud"><b data-how-i>01</b> / {String(principles.length).padStart(2, "0")}</span>
    </div>
    <div class="how-stage">
      <p class="display how-title" data-how-title>{principles[0].title}</p>
      <p class="how-note" data-how-note>{principles[0].note}</p>
    </div>
    <div class="how-bar" aria-hidden="true"><span data-how-bar></span></div>
    <ol class="sr-only">
      {principles.map((p) => <li>{p.title} {p.note}</li>)}
    </ol>
  </div>
  <script type="application/json" data-how-data set:html={JSON.stringify(principles)} />
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrambleTextPlugin } from "gsap/ScrambleTextPlugin";
  gsap.registerPlugin(ScrollTrigger, ScrambleTextPlugin);

  document.addEventListener("astro:page-load", () => {
    const sec = document.querySelector<HTMLElement>("[data-how]");
    if (!sec || sec.dataset.ready) return;
    sec.dataset.ready = "1";
    const data = JSON.parse(sec.querySelector("[data-how-data]")!.textContent!) as { title: string; note: string }[];
    const title = sec.querySelector<HTMLElement>("[data-how-title]")!;
    const note = sec.querySelector<HTMLElement>("[data-how-note]")!;
    const idx = sec.querySelector<HTMLElement>("[data-how-i]")!;
    const bar = sec.querySelector<HTMLElement>("[data-how-bar]")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    const show = (i: number) => {
      if (i === current) return;
      current = i;
      idx.textContent = String(i + 1).padStart(2, "0");
      if (reduced) {
        title.textContent = data[i].title;
        note.textContent = data[i].note;
        return;
      }
      gsap.to(title, { duration: 0.7, scrambleText: { text: data[i].title, chars: "01<>/_#*", speed: 0.6 }, ease: "none", overwrite: true });
      gsap.fromTo(note, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, delay: 0.2, overwrite: true, onStart: () => (note.textContent = data[i].note) });
    };
    ScrollTrigger.create({
      trigger: sec,
      start: "top top",
      end: "bottom bottom",
      onUpdate: (self) => {
        bar.style.transform = `scaleX(${self.progress.toFixed(4)})`;
        show(Math.min(data.length - 1, Math.floor(self.progress * data.length)));
      },
    });
  });
</script>

<style>
  .how {
    position: relative;
    height: 320vh;
  }
  .how-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(24px, 4vw, 48px);
    padding-block: calc(var(--nav-h) + 12px) 32px;
  }
  .how-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .how-head h2 {
    font: inherit;
    margin: 0;
  }
  .how-head b {
    font-weight: 400;
    color: var(--accent-as-text);
  }
  .how-stage {
    min-height: 40vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .how-title {
    margin: 0;
    font-size: clamp(2.6rem, 1rem + 6.5vw, 8rem);
    line-height: 0.95;
    max-width: 14ch;
  }
  .how-note {
    margin: clamp(16px, 2vw, 28px) 0 0;
    max-width: 48ch;
    font-size: var(--text-lead);
    color: var(--fg-muted);
  }
  .how-bar {
    height: 2px;
    background: var(--line);
  }
  .how-bar span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
