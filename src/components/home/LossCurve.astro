---
/**
 * Variant 2 — "From data to deployed".
 * A sticky chart: as you scroll, a training-loss curve draws itself, the epoch and
 * loss read-outs tick, and four stops (Data → Model → System → Interface) light up
 * with one real example each. The run ends on a DEPLOYED stamp.
 * Examples come from content collections.
 */
import { getCollection, getEntry } from "astro:content";

const exp = await getCollection("experience");
const records = exp.flatMap((e) => e.data.highlights).map((h) => h.match(/([\d.,]+K\+)\s+booking records/)?.[1]).find(Boolean);
const runs = (await getEntry("lab", "gans-under-data-scarcity"))?.data.metrics.find((m) => m.label === "Training runs")?.value;
const desigo = (await getEntry("projects", "desigo-platform"))?.data;
const tests = desigo?.metrics.find((m) => m.label === "ERP database tests")?.value;

const stops = [
  { t: 0.12, key: "Data", text: records ? `${records} booking records cleaned and modelled for TourIQ.` : "Raw records cleaned and modelled." },
  { t: 0.38, key: "Model", text: runs ? `${runs} controlled GAN training runs under data scarcity.` : "Controlled training runs." },
  { t: 0.64, key: "System", text: tests ? `${tests} automated database tests behind the DESIGO® ERP.` : "Tested systems." },
  { t: 0.9, key: "Interface", text: desigo?.status ? `${desigo.status.split("·")[0].trim()}.` : "Apps in people's hands." },
];

// A deterministic loss curve: fast drop, noisy plateau.
const W = 1000, H = 420, X0 = 40, X1 = 960, Y0 = 380, Y1 = 40;
const loss = (t: number) => 0.86 * Math.exp(-4.2 * t) + 0.09 + 0.035 * Math.sin(t * 61) * Math.exp(-1.5 * t) + 0.012 * Math.sin(t * 173);
const pt = (t: number, f = loss) => [X0 + (X1 - X0) * t, Y0 - (Y0 - Y1) * f(t)] as const;
const N = 160;
const path = Array.from({ length: N + 1 }, (_, i) => pt(i / N)).map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
const val = (t: number) => loss(t) + 0.05 + 0.04 * t;
const valPath = Array.from({ length: N + 1 }, (_, i) => pt(i / N, val)).map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join(" ");
const marks = stops.map((s) => pt(s.t));
---

<section class="loss" data-variant="2" data-loss aria-labelledby="loss-title">
  <div class="loss-sticky frame">
    <div class="loss-head micro">
      <h2 id="loss-title" data-decode>01.3 — From data to deployed</h2>
      <span class="loss-readout hud"><span>Epoch <b data-loss-epoch>000</b>/120</span><span>Loss <b data-loss-val>0.950</b></span></span>
    </div>

    <div class="loss-chart">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        {[0, 1, 2, 3, 4].map((i) => <line class="grid" x1={X0} x2={X1} y1={Y1 + (i * (Y0 - Y1)) / 4} y2={Y1 + (i * (Y0 - Y1)) / 4}></line>)}
        <path class="val" d={valPath} data-loss-valpath></path>
        <path class="curve" d={path} data-loss-path></path>
        {marks.map(([x, y]) => <circle class="mark" cx={x.toFixed(1)} cy={y.toFixed(1)} r="7" data-loss-mark></circle>)}
      </svg>
      <p class="stamp-deployed" data-loss-stamp aria-hidden="true">Deployed</p>
    </div>

    <ol class="loss-stops">
      {
        stops.map((s, i) => (
          <li data-loss-stop data-t={s.t}>
            <span class="micro">0{i + 1} — {s.key}</span>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    const sec = document.querySelector<HTMLElement>("[data-loss]");
    if (!sec || sec.dataset.ready) return;
    sec.dataset.ready = "1";
    const path = sec.querySelector<SVGPathElement>("[data-loss-path]")!;
    const valPath = sec.querySelector<SVGPathElement>("[data-loss-valpath]")!;
    const marks = Array.from(sec.querySelectorAll<SVGCircleElement>("[data-loss-mark]"));
    const stops = Array.from(sec.querySelectorAll<HTMLElement>("[data-loss-stop]"));
    const epoch = sec.querySelector("[data-loss-epoch]")!;
    const lossOut = sec.querySelector("[data-loss-val]")!;
    const stamp = sec.querySelector<HTMLElement>("[data-loss-stamp]")!;
    const loss = (t: number) => 0.86 * Math.exp(-4.2 * t) + 0.09 + 0.035 * Math.sin(t * 61) * Math.exp(-1.5 * t) + 0.012 * Math.sin(t * 173);
    const set = (p: number) => {
      // reveal left-to-right (non-scaling strokes make dash lengths unreliable)
      const cut = `inset(-5% ${(100 * (1 - (0.04 + 0.92 * p))).toFixed(2)}% -5% -1%)`;
      path.style.clipPath = cut;
      valPath.style.clipPath = cut;
      epoch.textContent = String(Math.round(p * 120)).padStart(3, "0");
      lossOut.textContent = loss(p).toFixed(3);
      stops.forEach((s, i) => {
        const on = p >= Number(s.dataset.t) - 0.02;
        s.classList.toggle("on", on);
        marks[i]?.classList.toggle("on", on);
      });
      stamp.classList.toggle("on", p > 0.97);
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return set(1);
    set(0);
    const st = { p: 0 };
    gsap.to(st, {
      p: 1,
      ease: "none",
      onUpdate: () => set(st.p),
      scrollTrigger: { trigger: sec, start: "top top", end: "bottom bottom", scrub: 0.5 },
    });
  });
</script>

<style>
  .loss {
    position: relative;
    height: 280vh;
  }
  .loss-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(16px, 2.4vw, 32px);
    padding-block: calc(var(--nav-h) + 12px) 24px;
  }
  .loss-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .loss-head h2 {
    font: inherit;
    margin: 0;
  }
  .loss-readout {
    display: flex;
    gap: 20px;
  }
  .loss-readout b {
    font-weight: 400;
    color: var(--fg);
  }
  .loss-chart {
    position: relative;
    flex: 1 1 auto;
    min-height: 180px;
    max-height: 46vh;
  }
  .loss-chart svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .curve {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .val {
    stroke-dasharray: 4 6;
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .mark {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.5s cubic-bezier(0.2, 1.8, 0.4, 1),
      fill 0.4s var(--ease-out);
  }
  .mark:global(.on) {
    opacity: 1;
    transform: none;
    fill: var(--accent);
  }
  .stamp-deployed {
    position: absolute;
    right: 4%;
    top: 12%;
    margin: 0;
    padding: 0.25em 0.5em 0.15em;
    font-family: "Valorant", var(--font-display);
    font-size: clamp(1.4rem, 1rem + 2vw, 2.8rem);
    color: var(--accent-as-text);
    border: 3px solid currentColor;
    transform: rotate(-8deg) scale(1.6);
    opacity: 0;
    transition:
      opacity 0.2s,
      transform 0.45s cubic-bezier(0.2, 1.6, 0.4, 1);
  }
  .stamp-deployed:global(.on) {
    opacity: 1;
    transform: rotate(-8deg) scale(1);
  }
  .loss-stops {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 900px) {
    .loss-stops {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .loss-stops li {
    padding-top: 10px;
    border-top: 2px solid var(--line);
    opacity: 0.28;
    transition:
      opacity 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }
  .loss-stops li:global(.on) {
    opacity: 1;
    border-color: var(--accent);
  }
  .loss-stops p {
    margin: 6px 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
  }
</style>
