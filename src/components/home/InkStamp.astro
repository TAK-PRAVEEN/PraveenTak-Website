---
/**
 * "AI / ML ENGINEER" ink stamp (Valorant-style display face).
 * Pressed onto the paper: the type lands with a thump, black ink bleeds out
 * from the letters in ragged fibres, then is drawn back into the type.
 * Repeats slowly while on screen; hover stamps again.
 * The text is real HTML text (selectable, readable by screen readers);
 * the ink is an SVG filter animated with GSAP. Reduced motion: clean type.
 */
interface Props {
  text?: string;
}
const { text = "AI / ML ENGINEER" } = Astro.props;
---

<section class="stamp-wrap frame" aria-label={text} data-stamp>
  <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="ink-stamp" x="-20%" y="-60%" width="140%" height="220%" color-interpolation-filters="sRGB">
      <!-- bleed: grow the glyphs, tear the edge with noise, soften like wet ink -->
      <feMorphology in="SourceAlpha" operator="dilate" radius="0" result="grow" data-grow></feMorphology>
      <feTurbulence type="fractalNoise" baseFrequency="0.035 0.09" numOctaves="3" seed="4" result="noise"></feTurbulence>
      <feDisplacementMap in="grow" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" result="torn" data-tear></feDisplacementMap>
      <feGaussianBlur in="torn" stdDeviation="0" result="wet" data-wet></feGaussianBlur>
      <feComponentTransfer in="wet" result="bleed">
        <feFuncA type="table" tableValues="0 0 1 1"></feFuncA>
      </feComponentTransfer>
      <feFlood flood-color="#080809" result="ink"></feFlood>
      <feComposite in="ink" in2="bleed" operator="in" result="stain"></feComposite>
      <!-- slight print grain on the type itself -->
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="9" result="grain"></feTurbulence>
      <feComposite in="SourceGraphic" in2="grain" operator="arithmetic" k1="0" k2="1" k3="-0.12" k4="0" result="printed"></feComposite>
      <feMerge>
        <feMergeNode in="stain"></feMergeNode>
        <feMergeNode in="printed"></feMergeNode>
      </feMerge>
    </filter>
  </svg>

  <div class="meta micro">
    <span>01.0 — Role</span>
    <span class="text-muted">Stamped · {new Date().getFullYear()}</span>
  </div>
  <p class="stamp" data-stamp-text>{text}</p>
</section>

<script>
  import { gsap } from "gsap";

  function init() {
    const root = document.querySelector<HTMLElement>("[data-stamp]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const el = root.querySelector<HTMLElement>("[data-stamp-text]")!;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const grow = root.querySelector("[data-grow]")!;
    const tear = root.querySelector("[data-tear]")!;
    const wet = root.querySelector("[data-wet]")!;
    el.style.filter = "url(#ink-stamp)";
    const flood = root.querySelector("feFlood")!;
    const setInk = () => flood.setAttribute("flood-color", document.documentElement.dataset.theme === "dark" ? "#f0f0ee" : "#080809");
    setInk();
    window.addEventListener("themechange", setInk);

    const tl = gsap.timeline({ paused: true });
    tl.set(el, { opacity: 0, scale: 1.18, filter: "url(#ink-stamp) blur(6px)" })
      // the press
      .to(el, { opacity: 1, scale: 1, filter: "url(#ink-stamp) blur(0px)", duration: 0.35, ease: "power4.in" })
      .fromTo(el, { y: 0 }, { y: 3, duration: 0.06, yoyo: true, repeat: 1 }, ">-0.02")
      // ink spreads out of the letters (fast, then slower — soaking into paper)
      .fromTo(grow, { attr: { radius: 0 } }, { attr: { radius: 7 }, duration: 1.4, ease: "expo.out" }, "<")
      .fromTo(tear, { attr: { scale: 0 } }, { attr: { scale: 42 }, duration: 1.4, ease: "expo.out" }, "<")
      .fromTo(wet, { attr: { stdDeviation: 0 } }, { attr: { stdDeviation: 2.2 }, duration: 1.4, ease: "expo.out" }, "<")
      // hold, then the ink is drawn back into the type
      .to(grow, { attr: { radius: 0 }, duration: 2.2, ease: "power2.inOut" }, "+=0.9")
      .to(tear, { attr: { scale: 0 }, duration: 2.2, ease: "power2.inOut" }, "<")
      .to(wet, { attr: { stdDeviation: 0 }, duration: 2.2, ease: "power2.inOut" }, "<");

    let visible = false;
    let timer = 0;
    const loop = () => {
      tl.restart();
      timer = window.setTimeout(() => visible && loop(), 7500);
    };
    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = e.isIntersecting;
      if (visible && !was) loop();
      if (!visible) clearTimeout(timer);
    }, { threshold: 0.4 }).observe(root);
    root.addEventListener("pointerenter", () => {
      if (tl.progress() > 0.6 || !tl.isActive()) tl.restart();
    });
    document.addEventListener("astro:before-swap", () => clearTimeout(timer), { once: true });
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  @font-face {
    font-family: "Valorant";
    src: url("/fonts/valorant.woff2") format("woff2");
    font-display: swap;
  }
  .stamp-wrap {
    padding-block: clamp(48px, 7vw, 112px) clamp(32px, 5vw, 80px);
  }
  .defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: clamp(24px, 4vw, 56px);
  }
  .stamp {
    margin: 0;
    font-family: "Valorant", var(--font-display);
    font-size: clamp(2.6rem, 0.5rem + 8.2vw, 9.5rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--fg);
    text-align: center;
    white-space: nowrap;
    transform-origin: 50% 60%;
    will-change: transform, filter;
  }
  @media (max-width: 600px) {
    .stamp {
      white-space: normal;
    }
  }
</style>
