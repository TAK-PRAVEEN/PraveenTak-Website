---
/**
 * Home scene: big numbers (Polymer 48 poster reference). Every figure is sourced
 * from content collections — nothing typed in by hand here.
 */
import { getCollection, getEntry } from "astro:content";

const projects = await getCollection("projects");
const lab = await getCollection("lab");
const certs = await getCollection("certifications");
const exp = await getCollection("experience", (e) => e.data.kind === "work");

const metric = (list: { data: { metrics: { label: string; value: string }[] } }[], id: string, label: string) =>
  list.find((x) => (x as unknown as { id: string }).id === id)?.data.metrics.find((m) => m.label === label)?.value;

const elevate = (await getEntry("experience", "elevate-labs"))?.data.highlights[0].match(/(\d+(?:\.\d+)?)%/)?.[1];

const items = [
  { value: metric(projects, "desigo-platform", "ERP database tests"), label: "Automated database tests", src: "DESIGO® ERP", code: "SRB/ERP-01" },
  { value: elevate ? `${elevate}%` : undefined, label: "Sign-language validation accuracy", src: "Elevate Labs", code: "CV/ASL-36" },
  { value: metric(lab, "gans-under-data-scarcity", "Training runs"), label: "Controlled GAN training runs", src: "GANs Under Data Scarcity", code: "GAN/4x4" },
  { value: String(certs.length), label: "Certifications completed", src: "Infosys · AWS · Google · DeepLearning.AI", code: `CRT/${certs.length}` },
  { value: String(exp.length), label: "Internships & roles", src: "DRDO · Infosys · Elevate · PW · Create Consciously", code: `EXP/${String(exp.length).padStart(2, "0")}` },
].filter((i): i is { value: string; label: string; src: string; code: string } => !!i.value);
---

<section class="frame numbers" aria-labelledby="numbers-title" data-numbers>
  <div class="numbers-head micro">
    <h2 id="numbers-title" data-decode>By the numbers</h2>
    <span class="dim">Sourced from case studies & experience</span>
  </div>
  <ol class="numbers-grid">
    {
      items.map((it, i) => (
        <li class:list={["num", { wide: i === 0 }]}>
          <div class="num-top hud">
            <span class="num-index">{String(i + 1).padStart(2, "0")}</span>
            <span class="num-code">{it.code}</span>
          </div>
          <p class="numeral num-value" data-count={it.value}>{it.value}</p>
          <div class="num-bottom">
            <p class="num-label">{it.label}</p>
            <p class="hud num-src">{it.src}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .numbers {
    padding-top: clamp(80px, 12vw, 200px);
  }
  .numbers-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .numbers-head h2 {
    font: inherit;
    margin: 0;
  }
  .dim {
    color: var(--fg-muted);
  }
  .numbers-grid {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .numbers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .num.wide {
      grid-column: 1 / -1;
    }
  }
  /* Each figure is its own clear card. */
  .num {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    min-height: 260px;
    padding: clamp(20px, 2.4vw, 32px);
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--panel);
  }
  .num-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--fg-muted);
  }
  .num-index {
    color: var(--fg);
  }
  .num-value {
    margin: 0;
    font-size: clamp(3rem, 1rem + 5vw, 6rem);
    white-space: nowrap;
  }
  .wide .num-value {
    font-size: clamp(4.5rem, 1.5rem + 9vw, 11rem);
  }
  .num-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .num-label {
    margin: 0;
    font-size: var(--text-lead);
    font-weight: 500;
  }
  .num-src {
    margin: 0;
    font-size: 9px;
    color: var(--fg-muted);
  }
</style>
