---
/**
 * Global navigation. Swiss top rule on desktop, full-screen index on mobile.
 * Glass treatment appears only once the page scrolls (DESIGN.md §5).
 */
import { Moon, Sun } from "@lucide/astro";
import { EXPERIENCES, SITE } from "../../config/site";

interface Props {
  current: string;
}
const { current } = Astro.props;
const links = EXPERIENCES.filter((e) => e.href !== "/");
const total = String(EXPERIENCES.length).padStart(2, "0");
const chapter = EXPERIENCES.find((e) => e.href === current)?.index ?? "01";
---

<header class="nav" data-nav transition:persist="nav">
  <div class="frame nav-row">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="brand-mark" aria-hidden="true">PT<i class="brand-dot"></i></span>
      <span class="brand-sig" aria-hidden="true">
        <video class="brand-sig-media" src="/media/signature.webm" poster="/media/signature-still.webp" autoplay muted loop playsinline preload="metadata"></video>
      </span>
      <span class="sr-only">{SITE.name}</span>
    </a>

    <!-- Instrument panel: live Jaipur time + current chapter (desktop). -->
    <div class="hud nav-hud" aria-hidden="true">
      <span><span class="hud-dim">IST</span> <span data-hud-time>--:--:--</span></span>
      <span><span class="hud-dim">CH</span> <span data-hud-chapter>{chapter}</span>/{total}</span>
    </div>

    <nav aria-label="Primary" class="nav-desktop">
      <ul data-nav-list>
        <li class="nav-blob" data-nav-blob aria-hidden="true"></li>
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="micro nav-link" aria-current={current === l.href ? "page" : undefined}>
                <span class="nav-index ink-text" aria-hidden="true">{l.index}</span>
                <span class="ink-text">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="hud palette-btn" type="button" data-liquid data-palette-open aria-label="Open command palette (Ctrl+K)">⌘K</button>

    <button class="theme-toggle" type="button" data-liquid data-theme-toggle aria-label="Switch to dark theme" title="Switch theme">
      <Sun class="icon-sun" size={16} aria-hidden="true" />
      <Moon class="icon-moon" size={16} aria-hidden="true" />
    </button>

    <button class="micro nav-toggle" type="button" data-liquid aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
      <span data-nav-toggle-label>Menu</span>
    </button>
  </div>

  <div class="nav-progress" data-hud-progress aria-hidden="true"></div>

  <div id="nav-panel" class="nav-panel" hidden data-nav-panel>
    <!-- Radial dial (references: Huly dial, space UI). Drag to spin; it snaps one page to the top. -->
    <nav aria-label="Primary mobile" class="dial-wrap">
      <div class="dial" data-dial style={`--n:${EXPERIENCES.length}`}>
        <svg class="dial-ticks" viewBox="-100 -100 200 200" aria-hidden="true">
          {
            Array.from({ length: 72 }, (_, i) => (
              <line x1="0" y1={i % 6 === 0 ? -99 : -96} x2="0" y2="-92" transform={`rotate(${i * 5})`} class:list={{ major: i % 6 === 0 }} />
            ))
          }
          <path d="M0 -99 L4 -104 L-4 -104 Z" class="dial-pointer" />
        </svg>
        <ul class="dial-ring" data-dial-ring>
          {
            EXPERIENCES.map((l, i) => (
              <li style={`--i:${i}`}>
                <a href={l.href} class="dial-item" data-dial-item={i} aria-current={current === l.href ? "page" : undefined}>
                  <span class="hud">{l.index}</span>
                  <span class="dial-label">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={current} class="dial-core" data-dial-core aria-label="Open selected page">
          <span class="hud" data-dial-core-index>01</span>
          <span class="dial-core-label" data-dial-core-label>Home</span>
          <span class="micro dial-core-hint">Spin · tap to open</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { currentTheme, onThemeChange, setTheme } from "../../lib/theme";
  import { inkTransition } from "../../lib/ink-transition";
  import { gsap } from "gsap";

  /** Radial dial: drag to spin, snaps one page to the pointer at the top; the core opens it. */
  function setupDial() {
    const dial = document.querySelector<HTMLElement>("[data-dial]");
    if (!dial || dial.dataset.ready) return null;
    dial.dataset.ready = "true";
    const items = Array.from(dial.querySelectorAll<HTMLAnchorElement>("[data-dial-item]"));
    const core = dial.querySelector<HTMLAnchorElement>("[data-dial-core]")!;
    const coreIdx = dial.querySelector<HTMLElement>("[data-dial-core-index]")!;
    const coreLabel = dial.querySelector<HTMLElement>("[data-dial-core-label]")!;
    const n = items.length;
    const step = 360 / n;
    const state = { deg: 0 };

    const render = () => {
      dial.style.setProperty("--ring", `${state.deg}deg`);
      const sel = (((Math.round(-state.deg / step)) % n) + n) % n;
      items.forEach((a, i) => a.toggleAttribute("data-selected", i === sel));
      const a = items[sel];
      core.href = a.getAttribute("href") ?? "/";
      coreIdx.textContent = a.querySelector(".hud")?.textContent ?? "";
      coreLabel.textContent = a.querySelector(".dial-label")?.textContent ?? "";
    };
    const snap = () =>
      gsap.to(state, { deg: Math.round(state.deg / step) * step, duration: 0.7, ease: "elastic.out(1, 0.55)", onUpdate: render });

    let dragging = false;
    let moved = 0;
    let last = 0;
    const angle = (e: PointerEvent) => {
      const r = dial.getBoundingClientRect();
      return (Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180) / Math.PI;
    };
    dial.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest("[data-dial-core]")) return;
      dragging = true;
      moved = 0;
      last = angle(e);
      gsap.killTweensOf(state);
    });
    window.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      let d = angle(e) - last;
      if (d > 180) d -= 360;
      if (d < -180) d += 360;
      last += d;
      moved += Math.abs(d);
      state.deg += d;
      render();
    });
    window.addEventListener("pointerup", () => {
      if (!dragging) return;
      dragging = false;
      snap();
    });
    // A drag must never also count as a tap on a link.
    dial.addEventListener("click", (e) => {
      if (moved > 6 && !(e.target as HTMLElement).closest("[data-dial-core]")) {
        e.preventDefault();
        e.stopPropagation();
      }
      moved = 0;
    }, true);

    return {
      /** Spin the ring in and settle on the current page. */
      spinIn() {
        const cur = Math.max(0, items.findIndex((a) => a.getAttribute("aria-current") === "page"));
        const target = -cur * step;
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        gsap.killTweensOf(state);
        if (reduced) {
          state.deg = target;
          render();
          return;
        }
        state.deg = target - 160;
        render();
        gsap.to(state, { deg: target, duration: 1.1, ease: "expo.out", onUpdate: render });
      },
    };
  }
  let dialApi: ReturnType<typeof setupDial> = null;

  function setupNav() {
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-nav-panel]");
    const label = document.querySelector<HTMLElement>("[data-nav-toggle-label]");
    if (!nav || !toggle || !panel || !label) return;

    const setOpen = async (open: boolean, animate = true) => {
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Close" : "Menu";
      document.documentElement.style.overflow = open ? "hidden" : "";
      document.dispatchEvent(new CustomEvent("scroll-lock", { detail: open }));
      if (open) {
        panel.hidden = false;
        dialApi?.spinIn();
      }
      if (animate) {
        const { animatePanel } = await import("../motion/liquid");
        await animatePanel(panel, toggle, open);
      }
      // A newer toggle may have happened while this animation ran: obey the latest state.
      if (toggle.getAttribute("aria-expanded") !== "true") panel.hidden = true;
    };
    void setOpen(false, false);
    dialApi = dialApi ?? setupDial();
    // The nav is persisted across navigations: bind listeners only once.
    if (nav.dataset.ready) return;
    nav.dataset.ready = "true";

    // Light / dark toggle.
    const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const syncThemeLabel = () =>
      themeBtn?.setAttribute("aria-label", currentTheme() === "dark" ? "Switch to light theme" : "Switch to dark theme");
    syncThemeLabel();
    onThemeChange(syncThemeLabel);
    // Ink drops from the button and spreads across the page (see ink-transition.ts).
    const palBtn = document.querySelector<HTMLButtonElement>("[data-palette-open]");
    if (palBtn) palBtn.onclick = () => document.dispatchEvent(new Event("palette:open"));
    let switching = false;
    if (themeBtn)
      themeBtn.onclick = async () => {
        if (switching) return;
        switching = true;
        const next = currentTheme() === "dark" ? "light" : "dark";
        await inkTransition(themeBtn, () => setTheme(next));
        switching = false;
      };
    toggle.onclick = () => void setOpen(toggle.getAttribute("aria-expanded") !== "true");
    panel.onclick = (e) => {
      // Navigating away: close instantly so the next page isn't covered.
      if ((e.target as HTMLElement).closest("a")) void setOpen(false, false);
    };
    document.onkeydown = (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        void setOpen(false);
        toggle.focus();
      }
    };

    // Adopt the surface of the section directly beneath the bar (e.g. the Ink band on Home).
    let ticking = false;
    const update = () => {
      ticking = false;
      nav.toggleAttribute("data-scrolled", window.scrollY > 8);
      const below = document.elementFromPoint(window.innerWidth / 2, nav.offsetHeight + 1);
      const surface = below?.closest<HTMLElement>("[data-surface]:not([data-nav])")?.dataset.surface;
      const pageSurface = document.documentElement.dataset.surface;
      if (surface && surface !== pageSurface) nav.dataset.surface = surface;
      else delete nav.dataset.surface;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener("astro:after-swap", () => requestAnimationFrame(update));
  }
  document.addEventListener("astro:page-load", setupNav);

  // Keep aria-current correct when the persisted nav survives a navigation.
  document.addEventListener("astro:after-swap", () => {
    const path = "/" + (location.pathname.split("/")[1] ?? "");
    // The nav persists across pages: drop focus from the clicked link so no ring lingers.
    (document.activeElement as HTMLElement | null)?.closest?.("[data-nav]") && (document.activeElement as HTMLElement).blur();
    document.querySelectorAll<HTMLAnchorElement>("[data-nav] a[href]").forEach((a) => {
      if (a.getAttribute("href") === path) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--fg);
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav[data-scrolled] {
      background: var(--bg);
      backdrop-filter: none;
    }
  }
  .nav-row {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  @media (min-width: 960px) {
    .nav-row .theme-toggle {
      margin-left: 8px;
    }
    .nav-desktop {
      margin-left: auto;
    }
  }
  .nav-hud {
    display: none;
    gap: 22px;
    color: var(--fg);
  }
  .nav-hud .hud-dim {
    color: var(--fg-muted);
  }
  @media (min-width: 1180px) {
    .nav-hud {
      display: flex;
    }
  }
  /* Scroll progress line along the bottom edge of the bar. */
  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    pointer-events: none;
  }
  :global(:root[data-accent="mono"]) .nav-progress {
    background: var(--orange);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: -0.02em;
  }
  .nav-desktop {
    display: none;
  }
  .nav-desktop ul {
    position: relative;
    display: flex;
    gap: clamp(16px, 2.2vw, 36px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Liquid glass droplet behind the current link (positioned by liquid.ts). */
  .nav-blob {
    position: absolute;
    left: 0;
    top: 50%;
    height: 34px;
    width: 0;
    margin-top: -17px;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    background: color-mix(in oklab, var(--fg) 7%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 70%, transparent),
      inset 0 0 0 1px color-mix(in oklab, var(--fg) 10%, transparent);
    -webkit-backdrop-filter: blur(8px) saturate(1.4);
    backdrop-filter: blur(8px) saturate(1.4);
    transform-origin: center;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    gap: 6px;
    padding-block: 8px;
    color: var(--fg-muted);
    transition: color var(--dur-fast);
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--fg);
  }
  .nav-index {
    opacity: 0.55;
  }
  .nav-link[aria-current="page"] .nav-index {
    opacity: 1;
  }
  .palette-btn {
    display: none;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .palette-btn:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }
  @media (min-width: 960px) {
    .palette-btn {
      display: inline-block;
    }
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    transition: border-color var(--dur-fast);
  }
  .theme-toggle:hover {
    border-color: var(--line-strong);
  }
  .theme-toggle :global(svg) {
    grid-area: 1 / 1;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }
  .theme-toggle :global(.icon-sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(:root[data-theme="dark"]) .theme-toggle :global(.icon-sun) {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle :global(.icon-moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .nav-toggle {
    min-height: 44px;
    padding-inline: 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  @media (min-width: 960px) {
    .nav-desktop {
      display: block;
    }
    .nav-toggle {
      display: none;
    }
  }

  .nav-panel {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    background: var(--bg);
    overflow-y: auto;
    padding-block: 16px 48px;
  }
  .dial-wrap {
    display: grid;
    place-items: center;
    min-height: calc(100svh - var(--nav-h) - 64px);
  }
  .dial {
    --r: min(34vw, 160px);
    --ring: 0deg;
    position: relative;
    width: min(calc(var(--r) * 2 + 110px), calc(100vw - 16px));
    aspect-ratio: 1;
    touch-action: none;
    user-select: none;
  }
  .dial-ticks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(var(--ring));
    stroke: var(--fg-muted);
    stroke-width: 0.6;
    opacity: 0.7;
  }
  .dial-ticks .major {
    stroke: var(--fg);
    stroke-width: 1;
  }
  .dial-ticks .dial-pointer {
    fill: var(--orange);
    stroke: none;
    transform: rotate(calc(-1 * var(--ring)));
  }
  .dial-ring {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: rotate(var(--ring));
  }
  .dial-ring li {
    --a: calc(var(--i) * 360deg / var(--n));
    position: absolute;
    left: 50%;
    top: 50%;
    /* zero-size so it rotates around the dial's centre (not its own), keeping the ring round */
    width: 0;
    height: 0;
    transform: rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(-1 * (var(--a) + var(--ring))));
  }
  .dial-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    transform: translate(-50%, -50%);
    padding: 8px;
    color: var(--fg-muted);
    transition: color var(--dur-fast);
  }
  .dial-item[aria-current="page"],
  .dial-item[data-selected] {
    color: var(--fg);
  }
  .dial-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
  }
  .dial-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--r) * 1.05);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-radius: 50%;
    text-align: center;
    border: 1px solid var(--line);
    background: radial-gradient(circle at 35% 30%, color-mix(in oklab, var(--bg) 70%, white), var(--panel));
    box-shadow:
      inset 0 2px 0 color-mix(in oklab, white 55%, transparent),
      inset 0 -10px 24px color-mix(in oklab, var(--fg) 8%, transparent),
      0 18px 40px -18px rgb(0 0 0 / 0.45);
  }
  .dial-core-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 6vw, 2rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .dial-core-hint {
    color: var(--fg-muted);
    font-size: 9px;
  }
  /* Mouse clicks leave no box; keyboard focus still gets a soft ring. */
  .nav-link:focus,
  .brand:focus {
    outline: none;
  }
  .nav-link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 1px var(--line-strong);
    border-radius: 999px;
  }
  /* Glassmorphism, always on. The blur lives on a pseudo-layer: backdrop-filter on
     .nav itself would make it the containing block of the fixed mobile menu panel
     (squashing the menu into the 64 px bar). */
  .nav,
  .nav[data-scrolled] {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .nav::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    z-index: -1;
    background: color-mix(in oklab, var(--bg) 58%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.6) brightness(1.04);
    backdrop-filter: blur(22px) saturate(1.6) brightness(1.04);
    border-bottom: 1px solid color-mix(in oklab, var(--fg) 10%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 35%, transparent),
      0 10px 30px -18px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .nav[data-scrolled]::before {
    background: color-mix(in oklab, var(--bg) 66%, transparent);
  }
  :global(:root[data-theme="dark"]) .nav::before,
  .nav[data-surface="ink"]::before {
    background: color-mix(in oklab, var(--ink) 55%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 8%, transparent),
      0 10px 30px -18px rgb(0 0 0 / 0.6);
  }
  /* Links inherit full contrast on glass. */
  .nav .nav-link {
    color: color-mix(in oklab, var(--fg) 72%, transparent);
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav::before {
      background: var(--bg);
      backdrop-filter: none;
    }
  }
  /* PT monogram: square box, neon-orange square completing the T at the top right. */
  .brand-mark {
    position: relative;
  }
  .brand-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 5px;
    height: 5px;
    background: var(--orange);
    box-shadow: 0 0 6px var(--orange);
  }
  /* Animated signature in the bar (same artwork as the hero). */
  .brand-sig {
    display: block;
    width: 108px;
    height: 32px;
  }
  .brand-sig-media {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    pointer-events: none;
  }
  :global(:root[data-theme="dark"]) .brand-sig-media,
  :global(:root[data-surface="ink"]) .brand-sig-media,
  .nav[data-surface="ink"] .brand-sig-media {
    filter: invert(1);
  }
  @media (max-width: 420px) {
    .brand-sig {
      width: 84px;
    }
  }
</style>
