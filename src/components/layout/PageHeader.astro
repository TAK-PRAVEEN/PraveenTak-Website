---
/** Editorial page opener: meta row, giant title, optional serif statement. */
import { experienceFor } from "../../config/site";

interface Props {
  section: string;
  title: string;
  lead?: string;
  statement?: string;
  /** Optional 3D render (transparent PNG/WebP) floating beside the title. */
  visual?: string;
}
const { section, title, lead, statement, visual } = Astro.props;
const exp = experienceFor(section);
/** Long titles (case studies) get a smaller display size so they stay 1–2 lines. */
const long = title.length > 12;
---

<header class:list={["frame page-header", { "has-visual": visual }]}>
  {visual && <img class="visual" src={visual} alt="" width="1600" height="1600" decoding="async" fetchpriority="high" aria-hidden="true" />}
  <div class="meta micro">
    <span data-decode>{exp.index} — {exp.label}</span>
    <span class="text-muted" data-decode>{exp.summary}</span>
    <span class="text-muted caret">SYS_{new Date().getFullYear()}</span>
  </div>
  <hr class="rule-strong" />
  <h1 class:list={["display title", { long }]} data-reveal-lines>{title}</h1>
  {
    (lead || statement) && (
      <div class="grid-12 below">
        {statement && <p class="script statement col-span-4 md:col-span-5">{statement}</p>}
        {lead && <p class="lead col-span-4 md:col-span-6 md:col-start-7">{lead}</p>}
      </div>
    )
  }
</header>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--nav-h) + clamp(32px, 6vw, 96px));
    padding-bottom: clamp(48px, 7vw, 112px);
  }
  /* Floating 3D render (Blender) beside the title. */
  .visual {
    position: absolute;
    z-index: -1;
    right: max(-4vw, -40px);
    top: calc(var(--nav-h) + 24px);
    width: min(48vw, 640px);
    height: auto;
    pointer-events: none;
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-16px) rotate(-2deg);
    }
  }
  @media (max-width: 767px) {
    .visual {
      position: relative;
      right: auto;
      top: auto;
      width: 86%;
      margin: 0 auto -8%;
      display: block;
    }
  }
  /* With a visual, the lead moves to the left column so it never sits on the render. */
  @media (min-width: 768px) {
    .has-visual .lead {
      grid-column: 1 / span 6;
    }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 12px;
  }
  .title {
    font-size: var(--text-display);
    margin: 0.12em 0 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .title.long {
      font-size: min(3rem, 11vw);
    }
  @media (max-width: 767px) {
    .title {
      font-size: min(var(--text-display), 14vw);
      overflow-wrap: normal;
    }
    }
  .title.long {
    font-size: clamp(3rem, 1.2rem + 6vw, 8.5rem);
    line-height: 0.92;
    max-width: 18ch;
  }
  .below {
    margin-top: clamp(32px, 4vw, 64px);
    row-gap: 24px;
  }
  .statement {
    font-size: clamp(2rem, 1.3rem + 2.2vw, 3.4rem);
    margin: 0;
  }
  .lead {
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--fg-muted);
    margin: 0;
  }
</style>
