---
/**
 * Instrument panel (DESIGN.md §5, references: Polymer 48 ticks, space UI):
 *  - side scale: tick rail on the right edge with a marker + percentage
 *  - drives the nav's progress line, Jaipur clock and chapter counter
 * Persisted across navigations; decorative only (aria-hidden).
 */
const TICKS = 41;
---

<div class="scale" data-hud-scale aria-hidden="true" transition:persist="hud-scale">
  <div class="ticks">
    {Array.from({ length: TICKS }, (_, i) => <span class:list={["tick", { major: i % 10 === 0, mid: i % 5 === 0 && i % 10 !== 0 }]}></span>)}
  </div>
  <div class="marker" data-hud-marker>
    <span class="hud pct" data-hud-pct>000</span>
  </div>
</div>

<script>
  import { EXPERIENCES } from "../../config/site";

  let started = false;
  function init() {
    // Chapter counter follows the current route (the nav itself is persisted).
    const path = "/" + (location.pathname.split("/")[1] ?? "");
    const ch = document.querySelector<HTMLElement>("[data-hud-chapter]");
    if (ch) ch.textContent = EXPERIENCES.find((e) => e.href === path)?.index ?? "01";
    if (started) return;
    started = true;

    const root = document.documentElement;
    const time = document.querySelector<HTMLElement>("[data-hud-time]");
    const fmt = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false });
    const tickClock = () => time && (time.textContent = fmt.format(new Date()));
    tickClock();
    setInterval(tickClock, 1000);

    let ticking = false;
    const update = () => {
      ticking = false;
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const p = Math.min(1, Math.max(0, window.scrollY / max));
      root.style.setProperty("--progress", p.toFixed(4));
      const pct = document.querySelector<HTMLElement>("[data-hud-pct]");
      if (pct) pct.textContent = String(Math.round(p * 100)).padStart(3, "0");
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    document.addEventListener("astro:after-swap", () => requestAnimationFrame(update));
    update();
  }
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .scale {
    position: fixed;
    right: 14px;
    top: 50%;
    z-index: 40;
    height: min(46vh, 380px);
    transform: translateY(-50%);
    display: none;
    pointer-events: none;
    color: var(--fg);
  }
  @media (min-width: 1100px) and (hover: hover) {
    .scale {
      display: block;
    }
  }
  .ticks {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
  }
  .tick {
    width: 6px;
    height: 1px;
    background: var(--fg-muted);
    opacity: 0.55;
  }
  .tick.mid {
    width: 10px;
  }
  .tick.major {
    width: 16px;
    opacity: 1;
    background: var(--fg);
  }
  .marker {
    position: absolute;
    right: 0;
    top: 0;
    transform: translateY(calc(var(--progress, 0) * min(46vh, 380px) - 50%));
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .marker::after {
    content: "";
    width: 22px;
    height: 2px;
    background: var(--accent);
  }
  :global(:root[data-accent="mono"]) .marker::after {
    background: var(--orange);
  }
  .pct {
    font-size: 9px;
  }
</style>
