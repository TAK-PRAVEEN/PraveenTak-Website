---
/**
 * Ink bloom (ref: ink ring on paper — feathered radial streaks, white centre, drip).
 * A live fragment shader: blooms open when it enters the view, then slowly
 * breathes and bleeds; hovering spreads it a little further.
 * Reduced motion / no WebGL: a single still state is drawn once.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["bloom", className]} data-ink-bloom aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import { createContext, createProgram, uniforms, fitCanvas, rgb } from "../../lib/gl";
  import { onFrame, spring, prefersReducedMotion } from "../../lib/frame";
  import { currentTheme, onThemeChange } from "../../lib/theme";

  const VS = `#version 300 es
  in vec2 aPos; void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`;
  const FS = `#version 300 es
  precision highp float;
  uniform vec2 uRes; uniform float uTime, uGrow, uSpread; uniform vec3 uInk;
  out vec4 o;
  float h(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
  float vn(vec2 p) { vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
    return mix(mix(h(i), h(i + vec2(1, 0)), f.x), mix(h(i + vec2(0, 1)), h(i + vec2(1, 1)), f.x), f.y); }
  float fbm(vec2 p) { float s = 0.0, a = 0.5; for (int k = 0; k < 5; k++) { s += a * vn(p); p = p * 2.07 + 13.0; a *= 0.5; } return s; }
  void main() {
    vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / min(uRes.x, uRes.y);
    uv.y *= 0.86;                                  // slightly tall, eye-like
    uv *= 1.45;                                    // keep the whole halo inside the frame
    float r = length(uv), ang = atan(uv.y, uv.x);
    float t = uTime * 0.12;
    float g = uGrow * (1.0 + 0.08 * uSpread);
    float breathe = 0.5 + 0.5 * sin(uTime * 0.35);
    // seamless angular noise (sample on a circle)
    vec2 cs = vec2(cos(ang), sin(ang));
    float edgeIn = fbm(cs * 2.2 + t);
    float edgeOut = fbm(cs * 2.6 + 4.0 - t);
    float fibres = fbm(vec2(ang * 18.0, r * 9.0 - t * 3.0));
    float inner = (0.13 + 0.012 * breathe + 0.035 * edgeIn) * g;
    float outer = (0.30 + 0.02 * breathe + 0.07 * edgeOut) * g;
    float core = smoothstep(inner - 0.012, inner + 0.03, r) * (1.0 - smoothstep(outer - 0.05, outer + 0.015, r));
    // feathered halo: radial streaks bleeding outward
    float halo = smoothstep(outer + 0.26 * g, outer - 0.02, r) * smoothstep(outer - 0.06, outer + 0.01, r);
    halo *= smoothstep(0.42, 0.78, fibres) * (0.55 + 0.45 * edgeOut);
    // drip below
    float dx = abs(uv.x - 0.01 * sin(uv.y * 18.0 + t));
    float drip = (1.0 - smoothstep(0.012, 0.04, dx)) * smoothstep(-0.62 * g, -0.3 * g, uv.y) * step(uv.y, -0.2 * g) * 0.75;
    float ink = clamp(core * (0.88 + 0.12 * fibres) + halo * 0.85 + drip * fibres, 0.0, 1.0);
    ink *= 0.88 + 0.12 * h(gl_FragCoord.xy);      // paper grain
    o = vec4(uInk * ink, ink);
  }`;

  function mount(root: HTMLElement) {
    const canvas = root.querySelector("canvas")!;
    const gl = createContext(canvas);
    if (!gl) return root.remove();
    const prog = createProgram(gl, VS, FS);
    gl.useProgram(prog);
    gl.bindVertexArray(gl.createVertexArray());
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "aPos");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = uniforms(gl, prog, ["uRes", "uTime", "uGrow", "uSpread", "uInk"] as const);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
    const setInk = () => {
      gl.useProgram(prog);
      gl.uniform3fv(u.uInk, rgb(currentTheme() === "dark" ? "#f0f0ee" : "#080809"));
    };
    setInk();
    const offTheme = onThemeChange(setInk);
    const grow = { value: 0, velocity: 0 };
    const spread = { value: 0, velocity: 0 };
    let seen = false, hover = false, visible = false;
    window.addEventListener(
      "pointermove",
      (e) => {
        const r = root.getBoundingClientRect();
        hover = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2)) < r.width * 0.4;
      },
      { passive: true },
    );
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) seen = true;
    }).observe(root);
    const reduced = prefersReducedMotion();
    const draw = (t: number) => {
      fitCanvas(canvas, 1.5);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(u.uRes, canvas.width, canvas.height);
      gl.uniform1f(u.uTime, t);
      gl.uniform1f(u.uGrow, reduced ? 1 : Math.max(0, grow.value));
      gl.uniform1f(u.uSpread, Math.max(0, spread.value));
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };
    if (reduced) return draw(8);
    const stop = onFrame((t, dt) => {
      if (!visible) return;
      spring(grow, seen ? 1 : 0, dt, 4, 4.5); // slow bloom open
      spring(spread, hover ? 1 : 0, dt, 5, 5);
      draw(t);
    });
    document.addEventListener("astro:before-swap", () => (stop(), offTheme()), { once: true });
  }
  document.addEventListener("astro:page-load", () => document.querySelectorAll<HTMLElement>("[data-ink-bloom]").forEach(mount));
</script>

<style>
  .bloom {
    aspect-ratio: 1;
    width: 100%;
  }
  canvas {
    width: 100%;
    height: 100%;
  }
</style>
