---
/**
 * Sci-fi HUD dial (after the "Atlas" reference): an irregular plate with top/bottom tabs and side lobes,
 * a dense instrument band (ticks, hatching, barcodes, grip, labels), a live Earth in the window with
 * thin overlay rings, a recording-timer pill on the left and a "01 Jaipur" card on the right.
 * White plate in the light theme, black in the dark theme. Drag spins it in its own plane (hud-dial.ts);
 * the Earth and the cards stay upright.
 */
interface Props {
  class?: string;
  size?: string;
  label?: string;
}
const { class: cls, size = "min(560px, 86vw)", label = "Live Earth clock — drag to spin" } = Astro.props;

const C = 500;
const P = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [+(C + r * Math.cos(a)).toFixed(1), +(C + r * Math.sin(a)).toFixed(1)] as const;
};
const arc = (r: number, a0: number, a1: number) => {
  const [x0, y0] = P(r, a0), [x1, y1] = P(r, a1);
  return `M${x0} ${y0}A${r} ${r} 0 ${a1 - a0 > 180 ? 1 : 0} 1 ${x1} ${y1}`;
};
/** Closed ring band between radii r0 < r1 from a0 to a1 (degrees, clockwise from 12 o'clock). */
const band = (r0: number, r1: number, a0: number, a1: number) => {
  const [x0, y0] = P(r1, a0), [x1, y1] = P(r1, a1), [x2, y2] = P(r0, a1), [x3, y3] = P(r0, a0);
  const big = a1 - a0 > 180 ? 1 : 0;
  return `M${x0} ${y0}A${r1} ${r1} 0 ${big} 1 ${x1} ${y1}L${x2} ${y2}A${r0} ${r0} 0 ${big} 0 ${x3} ${y3}Z`;
};
const ticks = (r: number, n: number, len: number, every = 0, longLen = 0, from = 0, to = 360) =>
  Array.from({ length: n }, (_, i) => {
    const deg = (i / n) * 360;
    if (deg < from || deg > to) return "";
    const L = every && i % every === 0 ? longLen : len;
    const [x0, y0] = P(r, deg), [x1, y1] = P(r - L, deg);
    return `M${x0} ${y0}L${x1} ${y1}`;
  }).join("");
const radial = (r0: number, r1: number, deg: number) => {
  const [x0, y0] = P(r0, deg), [x1, y1] = P(r1, deg);
  return `M${x0} ${y0}L${x1} ${y1}`;
};
/** Small bars standing on a circle (barcode-like). */
const bars = (r: number, a0: number, a1: number, n: number, h: number, seed = 1) =>
  Array.from({ length: n }, (_, i) => {
    const deg = a0 + ((a1 - a0) * i) / (n - 1);
    const w = ((i * 7 + seed * 3) % 5) + 2;
    const [x, y] = P(r, deg);
    return { x, y, w, h: h * (0.5 + (((i * 13 + seed) % 7) / 12)), deg };
  });

// Plate silhouette (union of shapes in one fill)
const plateParts = [
  `M${C} ${C - 412}A412 412 0 1 1 ${C - 0.1} ${C - 412}Z`,
  "M352 132V92Q352 64 382 60L620 50Q650 48 650 78V132Z", // top tab
  "M392 862H608Q632 862 632 886V924Q632 950 606 950H394Q368 950 368 924V886Q368 862 392 862Z", // bottom tab
  band(380, 452, 206, 256), // left lobe (hatching lives here)
  band(380, 438, 98, 142), // right lower lobe
  band(380, 428, 292, 334), // upper-left step
  band(380, 434, 20, 44), // upper-right step
];
const ghost = [arc(472, 258, 300), arc(472, 18, 70), arc(470, 148, 190), arc(486, 262, 284)];
const hatchBand = band(352, 440, 210, 250);
const topCircles = [-18, -6, 6, 18].map((d) => P(372, d));
const vbarsL = bars(370, 256, 284, 7, 26, 2);
const barcodeBottom = bars(258, 160, 200, 16, 30, 5);
const gripR = (() => {
  // vertical grip capsule with bumps on its inner edge (right side of the band)
  const x = 868, y0 = 420, y1 = 600;
  let d = `M${x} ${y0}`;
  for (let y = y0; y <= y1; y += 20) d += `Q${x - 22} ${y + 10} ${x} ${y + 20}`;
  d += `L${x + 26} ${y1 + 20}Q${x + 40} ${y1 + 10} ${x + 40} ${y1 - 10}V${y0 + 10}Q${x + 40} ${y0 - 10} ${x + 26} ${y0}Z`;
  return d;
})();
---

<div class:list={["hud", cls]} style={`--hud-size:${size}`} data-hud-dial tabindex="0" role="img" aria-label={label}>
  <div class="hud-shadow" aria-hidden="true"></div>
  <div class="hud-3d" data-hud-3d>
    <!-- plate -->
    <svg class="layer plate" viewBox="0 0 1000 1000" aria-hidden="true">
      <defs>
        <radialGradient id="hud-pg" cx="40%" cy="30%" r="85%"><stop offset="0" class="pg0" /><stop offset="1" class="pg1" /></radialGradient>
        <pattern id="hud-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
          <rect width="2.4" height="9" class="hatch" />
        </pattern>
        <clipPath id="hud-hatch-clip"><path d={hatchBand} /></clipPath>
      </defs>
      {ghost.map((d, i) => <path d={d} class="ghost" stroke-width={i === 3 ? 10 : 3} />)}
      <g fill="url(#hud-pg)" class="plate-fill">{plateParts.map((d) => <path d={d} />)}</g>
      <path d={plateParts[0]} class="rim" />
      <circle cx="500" cy="500" r="336" class="window" />
      <!-- instrument band -->
      <circle cx="500" cy="500" r="346" class="d2" fill="none" />
      <circle cx="500" cy="500" r="392" class="d2" fill="none" />
      <path d={ticks(404, 180, 7, 15, 16)} class="d2" />
      <g clip-path="url(#hud-hatch-clip)"><rect x="40" y="200" width="460" height="700" fill="url(#hud-hatch)" /></g>
      <path d={band(352, 440, 210, 250)} class="d1" fill="none" />
      {vbarsL.map((b) => <rect x={b.x - b.w / 2} y={b.y - b.h / 2} width={b.w} height={b.h} class="f2" transform={`rotate(${b.deg} ${b.x} ${b.y})`} />)}
      {topCircles.map(([x, y]) => <circle cx={x} cy={y} r="10" class="d1" fill="none" stroke-width="2.5" />)}
      {topCircles.map(([x, y]) => <path d={`M${x - 5} ${y}H${x + 5}`} class="d1" stroke-width="2.5" />)}
      <defs><path id="hud-arc-text" d={arc(362, 300, 345)} /><path id="hud-arc-text2" d={arc(362, 150, 196)} /></defs>
      <text class="arc-t"><textPath href="#hud-arc-text">TIME TO SPIN ON AXIS · 23H 56M 04S</textPath></text>
      <text class="arc-t"><textPath href="#hud-arc-text2">LATITUDE 26.91 · LONGITUDE 75.79</textPath></text>
      <text x={P(372, 42)[0]} y={P(372, 42)[1]} class="lbl big" transform={`rotate(42 ${P(372, 42)[0]} ${P(372, 42)[1]})`}>X10</text>
      <text x={P(374, 228)[0]} y={P(374, 228)[1]} class="lbl big" transform={`rotate(-48 ${P(374, 228)[0]} ${P(374, 228)[1]})`}>X55</text>
      <text x={P(372, -52)[0]} y={P(372, -52)[1]} class="lbl">29</text>
      <text x={P(370, 136)[0]} y={P(370, 136)[1]} class="lbl big">26</text>
      <!-- small instruments -->
      <g transform={`translate(${P(372, 302).join(" ")})`}><circle r="22" class="d1" fill="none" stroke-width="3" /><circle r="8" class="f1" /><path d="M-30 0H-22M22 0H30" class="d1" stroke-width="2" /></g>
      <g transform={`translate(${P(372, 70).join(" ")})`}><circle r="18" class="d1" fill="none" stroke-width="2.5" /><path d="M0 0L9 -11" class="d1" stroke-width="2.5" /></g>
      <path d={gripR} class="grip" />
      <path d={arc(424, 104, 136)} class="d2" stroke-width="2" fill="none" stroke-dasharray="2 6" />
      <!-- top tab: three live gauges -->
      {[430, 500, 570].map((x, i) => (
        <g transform={`translate(${x} 92)`}>
          <circle r="17" class="d2" fill="none" stroke-width="3" />
          <circle r="8.5" class="gauge" fill="none" stroke-width="17" pathLength="100" stroke-dasharray="0 100" transform="rotate(-90)" data-gauge={["h", "m", "s"][i]} />
        </g>
      ))}
      <text x="612" y="80" class="lbl tiny">{"42"}</text>
      <path d="M372 118H628" class="d2" stroke-width="2" stroke-dasharray="14 6 4 6" />
      <!-- bottom tab -->
      <g class="lbl-mid">
        <circle cx="408" cy="906" r="13" class="d1" fill="none" stroke-width="2.5" /><circle cx="408" cy="906" r="3" class="f1" />
        <circle cx="592" cy="906" r="13" class="d1" fill="none" stroke-width="2.5" /><path d="M586 912L598 900M598 906V900H592" class="d1" stroke-width="2.5" fill="none" />
        <text x="470" y="913" class="lbl">‹</text>
        <text x="500" y="914" class="lbl mid" text-anchor="middle" data-hud="dom">--</text>
        <text x="530" y="913" class="lbl" text-anchor="end">›</text>
      </g>
      <text x={P(392, 168)[0]} y={P(392, 168)[1]} class="lbl tiny" transform={`rotate(-12 ${P(392, 168)[0]} ${P(392, 168)[1]})`}>123.4 · 25.98 · 0.4</text>
    </svg>

    <!-- live Earth -->
    <canvas class="layer globe" data-hud-globe aria-hidden="true"></canvas>

    <!-- overlay rings over the window (spin with the plate) -->
    <svg class="layer rings" viewBox="0 0 1000 1000" aria-hidden="true">
      <!-- tinted zones like the reference's zoomed rings -->
      <path d={band(176, 240, 0, 359.9)} class="zone1" />
      <circle cx="500" cy="500" r="122" class="zone2" />
      <path d={band(240, 300, 300, 360)} class="zone3" />
      <circle cx="500" cy="500" r="318" class="o2" fill="none" stroke-dasharray="1 7" />
      <circle cx="500" cy="500" r="300" class="o1" fill="none" />
      <circle cx="500" cy="500" r="240" class="o2" fill="none" />
      <circle cx="500" cy="500" r="176" class="o1" fill="none" />
      <circle cx="500" cy="500" r="122" class="o2" fill="none" stroke-dasharray="3 5" />
      <circle cx="500" cy="500" r="66" class="o1" fill="none" />
      <path d={arc(300, -24, 8)} class="o1" stroke-width="7" fill="none" />
      <path d={arc(240, 196, 226)} class="o1" stroke-width="12" fill="none" />
      <path d={arc(176, 96, 132)} class="o1" stroke-width="5" fill="none" />
      <path d={arc(122, 300, 330)} class="o1" stroke-width="9" fill="none" />
      <path d={radial(70, 326, 332) + radial(70, 326, 152) + radial(180, 330, 18) + radial(66, 240, 208) + radial(66, 300, 96)} class="o1" fill="none" />
      <path d={ticks(300, 72, 8, 6, 16)} class="o2" />
      <g data-hud-spin><path d={ticks(240, 36, 10)} class="o1" /></g>
      {[6, 12].map((d) => { const [x0, y0] = P(260, d); const [x1, y1] = P(312, d); return <path d={`M${x0} ${y0}L${x1} ${y1}`} class="o1" stroke-width="10" />; })}
      {barcodeBottom.map((b) => <rect x={b.x - b.w / 2} y={b.y - b.h / 2} width={b.w} height={b.h} class="of" transform={`rotate(${b.deg} ${b.x} ${b.y})`} />)}
      <g data-hud-min><path d={arc(330, -3, 3)} class="o1" stroke-width="8" fill="none" /></g>
      <g data-hud-sec><path d="M500 500L500 168" class="o1" stroke-width="1.6" /><circle cx="500" cy="168" r="4" class="of" /></g>
      <path d="M494 500H506M500 494V506" class="o1" stroke-width="2" />
    </svg>

    <!-- upright overlay: pointer line + info -->
    <div class="layer cards">
      <svg class="pointer" viewBox="0 0 1000 1000" aria-hidden="true"><path d="M500 500L612 382L640 382" class="ptr" /><circle cx="500" cy="500" r="5" class="ptr-dot" /></svg>
      <div class="tag tag-rot micro"><span>ROTATION</span><b data-hud="gmst">—</b></div>
      <div class="tag tag-lat micro">26.9</div>
      <div class="tag tag-sun micro"><span data-hud="phase">—</span><b data-hud="daylen">—</b></div>

      <div class="card">
        <div class="card-bar" aria-hidden="true"><i></i><span class="micro">IST · LIVE</span></div>
        <div class="card-sub micro">Class · Earth</div>
        <div class="card-name"><span class="idx">01</span><span class="nm">Jaipur</span></div>
      </div>
      <div class="rows micro">
        <div class="row"><span>IST</span><span data-hud="ist">--:--:--</span></div>
        <div class="row"><span>UTC</span><span data-hud="utc">--:--:--</span></div>
        <div class="row"><span>Sunrise</span><span data-hud="rise">--:--</span></div>
        <div class="row"><span>Sunset</span><span data-hud="set">--:--</span></div>
      </div>

      <div class="timer">
        <div class="timer-top micro"><span class="rec"><i></i> Recording</span></div>
        <div class="timer-big"><span class="dim">IST</span> <span data-hud="ist-hm">--:--</span><small data-hud="ist-s">--</small></div>
        <div class="timer-bar"><i data-hud-secbar></i></div>
      </div>
    </div>
  </div>
  <p class="hud-hint micro">Hold &amp; drag around to spin · double-click to reset</p>
</div>

<script>
  import { mountHudDial } from "./hud-dial";
  const stops = new Map<HTMLElement, () => void>();
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-hud-dial]").forEach((el) => {
      if (!stops.has(el)) stops.set(el, mountHudDial(el));
    });
  });
  document.addEventListener("astro:before-swap", () => { stops.forEach((s) => s()); stops.clear(); });
</script>

<style>
  /* Light theme: white plate, ink details (the white "Atlas"). */
  .hud {
    --p0: #ffffff; --p1: #dcdcd8; --rim: rgb(0 0 0 / 0.16);
    --d1: #1a1a1c; --d2: rgb(26 26 28 / 0.42); --hatch: rgb(26 26 28 / 0.32); --ghost: rgb(255 255 255 / 0.75);
    --grip: #c9c9c5;
    --card-bg: #ffffff; --card-fg: #0b0b0c; --row-bg: #8b8b8f; --row-fg: #ffffff; --tag-bg: #0b0b0c; --tag-fg: #fff;
    position: relative;
    width: var(--hud-size);
    aspect-ratio: 1;
    perspective: 2000px;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
    container-type: inline-size;
  }
  /* Dark theme: black plate, white details (the black "Atlas"). */
  :global(:root[data-theme="dark"]) .hud {
    --p0: #1d1d20; --p1: #050506; --rim: rgb(255 255 255 / 0.12);
    --d1: #f2f2f0; --d2: rgb(242 242 240 / 0.42); --hatch: rgb(242 242 240 / 0.3); --ghost: rgb(255 255 255 / 0.14);
    --grip: #d9d9d6;
    --card-bg: #0b0b0c; --card-fg: #f2f2f0; --row-bg: #2e2e32; --row-fg: #e9e9e7; --tag-bg: #0b0b0c; --tag-fg: #fff;
  }
  .hud.is-grab { cursor: grabbing; }
  .hud:focus-visible { outline: 2px solid var(--accent, #ff5a1f); outline-offset: 8px; border-radius: 50%; }
  .hud-shadow { position: absolute; left: 10%; right: 10%; bottom: -4%; height: 14%; border-radius: 50%; background: radial-gradient(closest-side, rgb(0 0 0 / 0.3), transparent); pointer-events: none; }
  .hud-3d { position: absolute; inset: 0; transform-style: preserve-3d; will-change: transform; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .plate { transform: translateZ(-30px); overflow: visible; }
  .globe { inset: 17%; width: 66%; height: 66%; border-radius: 50%; transform: translateZ(-18px) rotateZ(calc(-1 * var(--spin, 0deg))); }
  .rings { transform: translateZ(8px); }
  .cards { transform: translateZ(60px) rotateZ(calc(-1 * var(--spin, 0deg))); pointer-events: none; }

  .pg0 { stop-color: var(--p0); }
  .pg1 { stop-color: var(--p1); }
  .rim { fill: none; stroke: var(--rim); stroke-width: 2; }
  .window { fill: #050507; }
  .ghost { fill: none; stroke: var(--ghost); stroke-linecap: round; }
  .d1 { stroke: var(--d1); }
  .d2 { stroke: var(--d2); stroke-width: 2; fill: none; }
  .f1 { fill: var(--d1); }
  .f2 { fill: var(--d2); }
  .hatch { fill: var(--hatch); }
  .grip { fill: var(--grip); stroke: var(--rim); stroke-width: 1.5; }
  .gauge { stroke: var(--d1); transition: stroke-dasharray 0.6s; }
  .arc-t { font-family: "Space Mono", monospace; font-size: 13px; letter-spacing: 3px; fill: var(--d2); }
  .lbl { font-family: "Inter Tight", sans-serif; font-weight: 500; font-size: 22px; fill: var(--d2); }
  .lbl.big { font-size: 30px; fill: var(--d2); }
  .lbl.tiny { font-family: "Space Mono", monospace; font-size: 11px; letter-spacing: 1px; }
  .lbl.mid { font-family: "Space Mono", monospace; font-size: 20px; fill: var(--d1); }
  .o1 { stroke: rgb(255 255 255 / 0.85); stroke-width: 1.6; }
  .o2 { stroke: rgb(255 255 255 / 0.4); stroke-width: 1.4; }
  .of { fill: rgb(255 255 255 / 0.85); }
  .zone1 { fill: rgb(255 191 0 / 0.1); }
  .zone2 { fill: rgb(44 255 255 / 0.1); }
  .zone3 { fill: rgb(255 255 255 / 0.07); }

  /* upright overlay */
  .pointer { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ptr { fill: none; stroke: #fff; stroke-width: 1.6; }
  .ptr-dot { fill: #fff; }
  .tag { position: absolute; display: flex; gap: 8px; align-items: baseline; padding: 0.35cqi 0.9cqi; background: var(--tag-bg); color: var(--tag-fg); border: 1px solid rgb(255 255 255 / 0.5); font-size: clamp(6px, 1.5cqi, 10px); letter-spacing: 0.08em; white-space: nowrap; }
  .tag b { font-weight: 400; }
  .tag-rot { left: 31%; top: 56%; }
  .tag-lat { left: 47.5%; top: 45.3%; }
  .tag-sun { left: 40%; top: 72%; }

  .card {
    position: absolute; left: 62.5%; top: 29%; width: 28%;
    padding: 1.1cqi 1.6cqi 1.4cqi;
    background: var(--card-bg); color: var(--card-fg);
    border-radius: 0.6cqi;
    clip-path: polygon(0 0, 100% 0, 100% 78%, 94% 100%, 0 100%);
    box-shadow: 0 1.6cqi 3.4cqi rgb(0 0 0 / 0.3);
  }
  .card-bar { display: flex; justify-content: space-between; align-items: center; gap: 1cqi; }
  .card-bar i { flex: 0 0 38%; height: 0.9cqi; background: repeating-linear-gradient(90deg, currentColor 0 1px, transparent 1px 3px, currentColor 3px 5px, transparent 5px 7px); opacity: 0.8; }
  .card-bar span { font-size: clamp(5px, 1.05cqi, 8px); opacity: 0.55; }
  .card-sub { margin-top: 0.8cqi; font-size: clamp(5px, 1.2cqi, 9px); opacity: 0.6; letter-spacing: 0.14em; }
  .card-name { display: flex; justify-content: space-between; align-items: baseline; margin-top: 0.6cqi; }
  .idx, .nm { text-transform: none; }
  .idx { font-family: var(--font-display); font-weight: 400; font-size: 4.2cqi; }
  .nm { font-family: var(--font-display); font-weight: 700; font-size: 6.4cqi; letter-spacing: -0.03em; line-height: 1; }
  .rows { position: absolute; left: 62.5%; top: calc(29% + 13.2cqi); width: 21%; display: grid; gap: 0.35cqi; font-size: clamp(5px, 1.1cqi, 8px); }
  .row { display: flex; justify-content: space-between; padding: 0.45cqi 0.9cqi; background: var(--row-bg); color: var(--row-fg); letter-spacing: 0.12em; }

  .timer {
    position: absolute; left: 6.5%; top: 52%; width: 20%;
    padding: 0.9cqi 1.3cqi 1cqi;
    background: var(--card-bg); color: var(--card-fg);
    border-radius: 1cqi;
    box-shadow: 0 1.2cqi 2.6cqi rgb(0 0 0 / 0.28);
  }
  .timer-top { font-size: clamp(5px, 1cqi, 8px); opacity: 0.65; letter-spacing: 0.14em; }
  .rec { display: inline-flex; align-items: center; gap: 0.6cqi; }
  .rec i { width: 0.8cqi; height: 0.8cqi; border-radius: 50%; background: var(--accent, #ff5a1f); animation: hud-pulse 1.2s ease-in-out infinite; }
  .timer-big { font-family: "Space Mono", monospace; font-size: 3.6cqi; line-height: 1.2; letter-spacing: 0.02em; white-space: nowrap; }
  .timer-big .dim { font-size: 0.42em; opacity: 0.45; vertical-align: 0.6em; }
  .timer-big small { font-size: 0.45em; opacity: 0.5; margin-left: 0.4em; }
  .timer-bar { margin-top: 0.6cqi; height: 0.45cqi; background: rgb(128 128 128 / 0.3); }
  .timer-bar i { display: block; height: 100%; width: 0; background: currentColor; }

  .hud-hint { position: absolute; left: 0; right: 0; bottom: -8%; text-align: center; opacity: 0.55; font-size: 11px; pointer-events: none; }
  @keyframes hud-pulse { 50% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) { .rec i { animation: none; } }
</style>
