---
/**
 * Matte stone that disintegrates (Blender render, scripts/render-rock.py):
 * a 30-frame sequence, faceted sphere → stone → membranes → smoke wisps. Hover plays it forward slowly, leaving
 * plays it back into the stone, slowly. Idle: a gentle float.
 * Reduced motion / before load: the solid stone (frame 0) as a still image.
 */
---

<div class="rock" data-rock>
  <img class="still" src="/media/rock/rock-00.webp" alt="" width="480" height="480" decoding="async" />
  <canvas aria-hidden="true"></canvas>
  <span class="micro hint">Hover to scatter</span>
</div>

<script>
  import { prefersReducedMotion } from "../../lib/frame";
  const TOTAL = 30;
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-rock]");
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = "1";
    if (prefersReducedMotion()) return;
    const canvas = root.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;
    const frames: (HTMLImageElement | null)[] = new Array(TOTAL).fill(null);
    for (let i = 0; i < TOTAL; i += 1) {
      const img = new Image();
      img.decoding = "async";
      img.src = `/media/rock/rock-${String(i).padStart(2, "0")}.webp`;
      img.onload = () => {
        frames[i] = img;
        if (i === 0) root.classList.add("ready");
      };
    }
    const nearest = (i: number) => {
      for (let d = 0; d < TOTAL; d++) {
        const f = frames[Math.max(0, i - d)] ?? frames[Math.min(TOTAL - 1, i + d)];
        if (f) return f;
      }
      return null;
    };
    let pos = 0, target = 0, raf = 0, t0 = performance.now();
    // Hit-test by position (the visual sits behind the header's text layer).
    const within = (x: number, y: number) => {
      const r = root.getBoundingClientRect();
      return Math.hypot(x - (r.left + r.width / 2), y - (r.top + r.height / 2)) < r.width * 0.4;
    };
    window.addEventListener("pointermove", (e) => e.pointerType === "mouse" && (target = within(e.clientX, e.clientY) ? 1 : 0), { passive: true });
    window.addEventListener("pointerdown", (e) => e.pointerType !== "mouse" && within(e.clientX, e.clientY) && (target = target ? 0 : 1), { passive: true });
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      if (!visible) return;
      const dt = Math.min(0.05, (now - t0) / 1000);
      t0 = now;
      // slow, constant-rate playback: ~2.2 s to scatter, ~3 s to reassemble
      pos += target > pos ? Math.min(target - pos, dt / 2.2) : -Math.min(pos - target, dt / 3);
      const eased = pos < 0.5 ? 2 * pos * pos : 1 - Math.pow(-2 * pos + 2, 2) / 2;
      const img = nearest(Math.round(eased * (TOTAL - 1)));
      if (!img) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = Math.round(canvas.clientWidth * dpr), h = Math.round(canvas.clientHeight * dpr);
      if (canvas.width !== w || canvas.height !== h) ((canvas.width = w), (canvas.height = h));
      ctx.clearRect(0, 0, w, h);
      const float = Math.sin(now / 1400) * 6 * dpr * (1 - eased);
      ctx.drawImage(img, 0, float, w, h);
    };
    raf = requestAnimationFrame(draw);
    document.addEventListener("astro:before-swap", () => cancelAnimationFrame(raf), { once: true });
  });
</script>

<style>
  .rock {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
  }
  canvas,
  .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  canvas {
    opacity: 0;
  }
  .rock:global(.ready) canvas {
    opacity: 1;
  }
  .rock:global(.ready) .still {
    opacity: 0;
  }
  :global(:root[data-theme="dark"]) .rock {
    filter: brightness(1.35);
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%);
    color: var(--fg-muted);
    font-size: 9px;
  }
</style>
