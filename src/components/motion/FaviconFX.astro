---
/**
 * Animated favicon: the orange square is a pen that writes "PT" in the browser tab.
 *   P — up the stem from the bottom, across the top, round the bowl and back to the stem.
 *   T — up its stem, left to the start of the bar, then right along the bar, stopping
 *       at the bar's tip where it stays as the orange square.
 * Frames are drawn on a small canvas and swapped into <link rel="icon">. Plays on the
 * first load and again when the visitor returns to the tab. Skipped under reduced motion.
 * Browsers that ignore favicon changes (Safari) keep the static /icons/favicon-48.png.
 *
 * Geometry is in the 256 px space of /icons/favicon-glyph.png (rendered by
 * scripts/make-brand-assets.mjs): stems 20 px, bars 16-17 px, square 16.6 px.
 */
---

<script>
  const SIZE = 64; // favicon canvas
  const K = SIZE / 256;
  const SQ = 16.6; // square side (= bar thickness)
  const FINAL = { x: 193.6 + SQ / 2, y: 79 + SQ / 2 }; // square's resting centre (bar tip)

  type Pt = [number, number];
  // P: stem bottom -> top -> right along the top -> round the bowl -> back to the stem.
  const arc = (cx: number, cy: number, r: number, a0: number, a1: number, n = 18): Pt[] =>
    Array.from({ length: n + 1 }, (_, i) => {
      const a = a0 + ((a1 - a0) * i) / n;
      return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
    });
  const P: Pt[] = [[57, 182], [57, 87], [85, 87], ...arc(85, 110.75, 23.75, -Math.PI / 2, Math.PI / 2).slice(1), [57, 134.5]];
  // T: stem bottom -> top -> left end of the bar -> right along the bar to the square's spot.
  const T: Pt[] = [[172, 182], [172, 87], [128, 87], [FINAL.x, FINAL.y]];

  const measure = (pts: Pt[]) => {
    const cum = [0];
    for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    return { pts, cum, len: cum[cum.length - 1] };
  };
  const strokes = [measure(P), measure(T)];
  const total = strokes[0].len + strokes[1].len;

  /** Points of a stroke up to distance d, plus the pen position at d. */
  const upTo = (s: ReturnType<typeof measure>, d: number): { path: Pt[]; at: Pt } => {
    const path: Pt[] = [s.pts[0]];
    for (let i = 1; i < s.pts.length; i++) {
      if (s.cum[i] <= d) path.push(s.pts[i]);
      else {
        const t = (d - s.cum[i - 1]) / (s.cum[i] - s.cum[i - 1]);
        const p: Pt = [s.pts[i - 1][0] + (s.pts[i][0] - s.pts[i - 1][0]) * t, s.pts[i - 1][1] + (s.pts[i][1] - s.pts[i - 1][1]) * t];
        path.push(p);
        return { path, at: p };
      }
    }
    return { path, at: s.pts[s.pts.length - 1] };
  };

  function start() {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const link = document.querySelector<HTMLLinkElement>('link[rel="icon"]');
    if (!link) return;
    const staticHref = link.href;
    const glyph = new Image();
    glyph.src = "/icons/favicon-glyph.png";

    const c = document.createElement("canvas");
    c.width = c.height = SIZE;
    const g = c.getContext("2d")!;
    const mask = document.createElement("canvas");
    mask.width = mask.height = SIZE;
    const m = mask.getContext("2d")!;

    const frame = (p: number) => {
      // progress (0..1) -> distance along P then T
      const d = p * total;
      const parts = d <= strokes[0].len ? [upTo(strokes[0], d)] : [upTo(strokes[0], strokes[0].len), upTo(strokes[1], d - strokes[0].len)];
      // mask: a thick pen line along the written part
      m.clearRect(0, 0, SIZE, SIZE);
      m.save();
      m.scale(K, K);
      m.lineWidth = 27;
      m.lineCap = "butt";
      m.lineJoin = "miter";
      m.strokeStyle = "#000";
      for (const { path } of parts) {
        m.beginPath();
        path.forEach(([x, y], i) => (i ? m.lineTo(x, y) : m.moveTo(x, y)));
        m.stroke();
      }
      m.globalCompositeOperation = "source-in";
      m.drawImage(glyph, 0, 0, 256, 256);
      m.restore();
      // tile + revealed letters + the pen (orange square)
      g.clearRect(0, 0, SIZE, SIZE);
      g.fillStyle = "#171719";
      g.beginPath();
      g.roundRect(0, 0, SIZE, SIZE, SIZE * 0.18);
      g.fill();
      g.drawImage(mask, 0, 0);
      const [px, py] = parts[parts.length - 1].at;
      g.fillStyle = "#ff5a1f";
      g.fillRect((px - SQ / 2) * K, (py - SQ / 2) * K, SQ * K, SQ * K);
      link.href = c.toDataURL("image/png");
    };

    let timer = 0;
    const play = () => {
      clearInterval(timer);
      const t0 = performance.now();
      const DUR = 2600;
      const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - (-2 * x + 2) ** 2 / 2);
      timer = window.setInterval(() => {
        const p = Math.min(1, (performance.now() - t0) / DUR);
        frame(ease(p));
        if (p >= 1) {
          clearInterval(timer);
          link.href = staticHref; // final state = the static icon (identical)
        }
      }, 40);
    };
    glyph.onload = () => {
      play();
      document.addEventListener("visibilitychange", () => document.visibilityState === "visible" && play());
    };
  }
  // once per full page load (the icon link survives client-side navigations)
  start();
</script>
