---
/**
 * Glass folder card (Work, Lab, Experience): a back panel with a fluid gradient, a paper sheet
 * that slides out on hover, and a frosted-glass front with an inward-curved tab and shiny corners.
 * "wide" = one big folder per row (desktop); it falls back to the compact shape on phones.
 * Tilts in 3D toward the pointer (glass-folder.ts).
 */
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  href?: string;
  title: string;
  kicker?: string;
  meta?: string;
  /** Summary: on the glass for wide folders, on the paper sheet for compact ones. */
  note?: string;
  /** Seed for the generated gradient. */
  seed?: number;
  tone?: "light" | "dark";
  badge?: string;
  wide?: boolean;
}
const { href, title, kicker, meta, note, seed = 0, tone = "light", badge, wide = false } = Astro.props;
const Tag = href ? "a" : "div";

// Fluid artwork — varies by seed (no project images, by request).
const hues = [
  ["#ff5a1f", "#1d3b6b", "#0b0b0c"],
  ["#2cffff", "#ff2c2c", "#101014"],
  ["#c9b8ff", "#ff5a1f", "#121216"],
  ["#ffbf00", "#2b5cff", "#0e0e10"],
  ["#ff2c6d", "#14b8a6", "#0c0c10"],
  ["#7c5cff", "#ffbf00", "#0d0d10"],
];
const [h1, h2, h3] = hues[seed % hues.length];
const ang = (seed * 47) % 360;
const px = 20 + ((seed * 37) % 60), py = 25 + ((seed * 53) % 50);

/** Folder outlines in objectBoundingBox units for a box W wide x 1 tall (curves stay round at any aspect). */
const f = (n: number) => +n.toFixed(4);
function shapes(W: number) {
  const R = 0.06, c = 0.13, t = 0.15, ft = 0.14 / 0.785;
  const X = (x: number) => f(x / W);
  const x0 = W - Math.min(W * 0.46, 1.05) - c; // back tab starts (right side)
  const back = `M0,${f(t + R)} Q0,${t} ${X(R)},${t} L${X(x0)},${t} C${X(x0 + c * 0.45)},${t} ${X(x0 + c * 0.55)},0 ${X(x0 + c)},0 L${X(W - R)},0 Q1,0 1,${R} L1,${f(1 - R)} Q1,1 ${X(W - R)},1 L${X(R)},1 Q0,1 0,${f(1 - R)} Z`;
  const r = R / 0.785;
  const x1 = Math.min(W * 0.34, 0.95);
  const front = `M0,${f(r)} Q0,0 ${X(R)},0 L${X(x1)},0 C${X(x1 + c * 0.45)},0 ${X(x1 + c * 0.55)},${f(ft)} ${X(x1 + c)},${f(ft)} L${X(W - R)},${f(ft)} Q1,${f(ft)} 1,${f(ft + r)} L1,${f(1 - r)} Q1,1 ${X(W - R)},1 L${X(R)},1 Q0,1 0,${f(1 - r)} Z`;
  return { back, front };
}
const NARROW = shapes(5 / 3.9);
const WIDE = shapes(2.7);
const uid = `gf${Math.random().toString(36).slice(2, 8)}`;
const clips = `--cb:url(#${uid}-b);--cf:url(#${uid}-f);--cbw:url(#${uid}-bw);--cfw:url(#${uid}-fw)`;
---

<Tag href={href} class:list={["gf", `gf-${tone}`, { "gf-wide": wide }]} style={clips} data-gf {...(href ? { "data-liquid": "" } : {})}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <clipPath id={`${uid}-b`} clipPathUnits="objectBoundingBox"><path d={NARROW.back} /></clipPath>
    <clipPath id={`${uid}-f`} clipPathUnits="objectBoundingBox"><path d={NARROW.front} /></clipPath>
    {wide && <clipPath id={`${uid}-bw`} clipPathUnits="objectBoundingBox"><path d={WIDE.back} /></clipPath>}
    {wide && <clipPath id={`${uid}-fw`} clipPathUnits="objectBoundingBox"><path d={WIDE.front} /></clipPath>}
  </svg>
  <span class="gf-shadow" aria-hidden="true"></span>
  <span class="gf-tilt">
    <span class="gf-back">
      <span class="gf-fluid" style={`--h1:${h1};--h2:${h2};--h3:${h3};--ang:${ang}deg;--px:${px}%;--py:${py}%`} aria-hidden="true"></span>
    </span>
    <span class="gf-paper" aria-hidden="true">{note && !wide && <span class="gf-note">{note}</span>}</span>
    <span class="gf-front">
      <span class="gf-grain" aria-hidden="true"></span>
      <span class="gf-text">
        {kicker && <span class="gf-kicker micro">{kicker}</span>}
        <span class="gf-title ink-text">{title}</span>
        {wide && note && <span class="gf-sum">{note}</span>}
        {meta && <span class="gf-meta micro">{meta}</span>}
      </span>
      {badge && <span class="gf-badge micro">{badge}</span>}
      {href && <span class="gf-btn" aria-hidden="true"><ArrowUpRight size={22} /></span>}
    </span>
    <svg class="gf-edge gf-edge-n" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
      <path d={NARROW.front} transform="translate(0 0.215) scale(1 0.785)" vector-effect="non-scaling-stroke" />
    </svg>
    {wide && (
      <svg class="gf-edge gf-edge-w" viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
        <path d={WIDE.front} transform="translate(0 0.215) scale(1 0.785)" vector-effect="non-scaling-stroke" />
      </svg>
    )}
  </span>
</Tag>

<script>
  import { mountGlassFolders } from "./glass-folder";
  let stop: (() => void) | null = null;
  document.addEventListener("astro:page-load", () => { stop?.(); stop = mountGlassFolders(); });
  document.addEventListener("astro:before-swap", () => { stop?.(); stop = null; });
</script>

<style>
  .gf {
    --rx: 0deg; --ry: 0deg; --lift: 0;
    --fg: #0b0b0c; --glass-a: rgb(255 255 255 / 0.62); --glass-b: rgb(255 255 255 / 0.22); --edge: rgb(255 255 255 / 0.95);
    --shine: rgb(255 255 255 / 0.75); --shine2: rgb(255 255 255 / 0.35);
    --paper: #fbfbf9; --btn: #0b0b0c; --btn-fg: #fff;
    position: relative;
    display: block;
    aspect-ratio: 5 / 3.9;
    perspective: 1400px;
    color: var(--fg);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  :global(:root[data-theme="dark"]) .gf,
  .gf-dark {
    --fg: #f4f4f2; --glass-a: rgb(22 22 26 / 0.72); --glass-b: rgb(8 8 10 / 0.42); --edge: rgb(255 255 255 / 0.3);
    --shine: rgb(255 255 255 / 0.22); --shine2: rgb(255 255 255 / 0.1);
    --paper: #1c1c20; --btn: #f4f4f2; --btn-fg: #0b0b0c;
  }
  .gf-back { clip-path: var(--cb); }
  .gf-front { clip-path: var(--cf); }
  .gf-edge-w { display: none; }
  @media (min-width: 768px) {
    .gf-wide { aspect-ratio: 2.7 / 1; }
    .gf-wide .gf-back { clip-path: var(--cbw); }
    .gf-wide .gf-front { clip-path: var(--cfw); }
    .gf-wide .gf-edge-n { display: none; }
    .gf-wide .gf-edge-w { display: block; }
  }

  .gf-tilt {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(calc(var(--lift) * 10px));
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gf-shadow {
    position: absolute; left: 6%; right: 6%; bottom: -5%; height: 18%;
    border-radius: 50%; background: radial-gradient(closest-side, rgb(0 0 0 / 0.32), transparent);
    filter: blur(6px); transform: scale(calc(1 - var(--lift) * 0.06)); opacity: calc(0.85 - var(--lift) * 0.25);
    transition: transform 0.5s, opacity 0.5s;
  }
  .gf-back {
    position: absolute; left: 2.5%; right: 2.5%; top: 0; bottom: 4%;
    display: block; overflow: hidden; background: #111;
    transform: translateZ(-20px);
  }
  .gf-fluid {
    position: absolute; inset: -20%; display: block;
    background:
      radial-gradient(40% 55% at var(--px) var(--py), var(--h1), transparent 70%),
      radial-gradient(45% 60% at 75% 30%, var(--h2), transparent 70%),
      conic-gradient(from var(--ang) at 50% 60%, var(--h3), var(--h2), var(--h1), var(--h3));
    filter: blur(18px) saturate(1.3);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gf:hover .gf-fluid { transform: rotate(8deg) scale(1.08); }
  .gf-paper {
    position: absolute; left: 12%; right: 12%; top: 13%; height: 50%;
    display: block; border-radius: 10px; background: var(--paper);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.18);
    transform: translateZ(-6px) translateY(calc(26% - var(--lift) * 30%));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 7% 7%;
  }
  .gf-wide .gf-paper { left: 30%; right: 8%; }
  .gf-note { display: block; font-size: 13px; line-height: 1.45; color: var(--fg); opacity: calc(var(--lift) * 0.85); transition: opacity 0.4s; }
  .gf-front {
    position: absolute; left: 0; right: 0; bottom: 0; height: 78.5%;
    display: block;
    /* frosted glass + shiny corners (top-left highlight, softer bottom-right) */
    background:
      radial-gradient(55% 85% at 0% 0%, var(--shine), transparent 60%),
      radial-gradient(45% 70% at 100% 100%, var(--shine2), transparent 60%),
      linear-gradient(180deg, var(--glass-a), var(--glass-b));
    -webkit-backdrop-filter: blur(22px) saturate(170%);
    backdrop-filter: blur(22px) saturate(170%);
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.65), inset 0 -24px 48px rgb(255 255 255 / 0.1), inset 0 0 0 1px rgb(255 255 255 / 0.18);
    transform: translateZ(14px);
  }
  .gf-grain {
    position: absolute; inset: 0; display: block; opacity: 0.14; mix-blend-mode: overlay; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .gf-edge {
    position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 100%;
    overflow: visible; pointer-events: none; transform: translateZ(15px);
  }
  .gf-edge path { fill: none; stroke: var(--edge); stroke-width: 1.2; opacity: 0.85; }
  .gf-text {
    position: absolute; left: 7%; right: 22%; bottom: 10%;
    display: flex; flex-direction: column; gap: 6px;
  }
  .gf-kicker { opacity: 0.7; }
  .gf-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(20px, 2vw, 28px); line-height: 1.05; letter-spacing: -0.02em; }
  .gf-sum { max-width: 58ch; font-size: clamp(15px, 1.15vw, 18px); line-height: 1.45; opacity: 0.78; }
  .gf-meta { opacity: 0.6; }
  @media (min-width: 768px) {
    .gf-wide .gf-text { left: 4%; right: 16%; bottom: 13%; gap: 10px; }
    .gf-wide .gf-title { font-size: clamp(32px, 3.6vw, 60px); line-height: 0.98; letter-spacing: -0.035em; }
    .gf-wide .gf-btn { right: 3%; bottom: 13%; width: clamp(60px, 5vw, 80px); }
  }
  @media (max-width: 767px) { .gf-sum { display: none; } }
  .gf-badge { position: absolute; right: 6%; top: 25%; max-width: 60%; text-align: right; padding: 4px 10px; border-radius: 999px; background: rgb(0 0 0 / 0.08); }
  .gf-wide .gf-badge { right: 3%; }
  :global(:root[data-theme="dark"]) .gf-badge, .gf-dark .gf-badge { background: rgb(255 255 255 / 0.12); }
  .gf-btn {
    position: absolute; right: 5.5%; bottom: 8%;
    width: clamp(48px, 4.6vw, 64px); aspect-ratio: 1; border-radius: 30%;
    display: grid; place-items: center;
    background: radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--btn) 70%, white), var(--btn) 55%);
    color: var(--btn-fg);
    box-shadow: 0 10px 22px rgb(0 0 0 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.35), inset 0 -3px 8px rgb(0 0 0 / 0.5);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gf:hover .gf-btn, .gf:focus-visible .gf-btn { transform: translateY(-3px) scale(1.04); }
  .gf:focus-visible { outline: 2px solid var(--accent, #ff5a1f); outline-offset: 6px; border-radius: 14px; }
  @media (hover: none) { .gf { --lift: 0.6; } }
  @media (prefers-reduced-motion: reduce) {
    .gf-tilt, .gf-paper, .gf-fluid { transition: none; }
  }
</style>
