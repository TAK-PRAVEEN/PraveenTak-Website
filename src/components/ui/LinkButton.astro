---
import { ArrowUpRight, ArrowRight } from "@lucide/astro";

interface Props {
  href: string;
  variant?: "solid" | "outline";
  external?: boolean;
}
const { href, variant = "solid", external = false } = Astro.props;
---

<a
  href={href}
  class:list={["btn", "micro", `btn-${variant}`]}
  data-liquid
  {...external ? { target: "_blank", rel: "noopener" } : {}}
>
  <span><slot /></span>
  {external ? <ArrowUpRight size={14} aria-hidden="true" /> : <ArrowRight size={14} aria-hidden="true" />}
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line-strong);
    transition: color 0.45s var(--ease-out) 0.05s;
  }
  /* The page-colour ink (global.css "Ink hover on links") fills the whole button. */
  .btn::before {
    inset: -1px;
    border-radius: 0;
  }
  .btn-solid {
    background: var(--fg);
    color: var(--bg);
  }
  /* On the ink, text turns the accent's readable partner (black on light accents). */
  .btn:is(:hover, :focus-visible, :active) {
    color: var(--accent-text);
  }
</style>
