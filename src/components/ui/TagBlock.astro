---
/** Accent fill + charcoal text tag (Braun "1976" reference). Always legible. */
interface Props {
  as?: "span" | "p" | "div";
  size?: "sm" | "lg";
}
const { as: Tag = "span", size = "sm" } = Astro.props;
---

<Tag class:list={["tag", size]}><slot /></Tag>

<style>
  .tag {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-text);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .sm {
    font-size: 11px;
    padding: 6px 8px;
  }
  .lg {
    font-family: var(--font-display);
    text-transform: none;
    letter-spacing: -0.03em;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    padding: 0.08em 0.2em 0.12em;
  }
</style>
