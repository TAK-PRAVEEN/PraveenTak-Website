---
import { getEntry } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import StatusDot from "../components/ui/StatusDot.astro";
import RefSequence from "../components/3d/RefSequence.astro";


const profile = (await getEntry("profile", "main"))!.data;
// Turnstile site key is public. Set PUBLIC_TURNSTILE_SITE_KEY at build time for production.
// Local dev uses Cloudflare's documented always-pass TEST key; a production build without a
// real key renders no widget (the form then falls back to the visitor's mail app).
// Production site key (public by design) for praveentak.dev / www / workers.dev.
const TURNSTILE_SITE_KEY = "0x4AAAAAAF7pn6An_FhJYhzE";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? "1x00000000000000000000AA" : TURNSTILE_SITE_KEY);
---

<BaseLayout title="Contact" section="/contact" description="Get in touch with Praveen Tak." bare>
  <div class="sky" aria-hidden="true"><div class="sky-img"></div></div>
  <div class="over-sky">
  <PageHeader section="/contact" title="Let's talk"><RefSequence slot="visual" name="sphere" frames={90} fps={25} /></PageHeader>

  <section class="frame grid-12 contact" aria-label="Contact">
    <div class="col-span-4 md:col-span-5 details">
      <StatusDot open={profile.availability.open} label={profile.availability.label} />
      <a href={`mailto:${profile.contact.email}`} class="heading email link-underline">{profile.contact.email}</a>
      {profile.contact.phone && <a href={`tel:${profile.contact.phone.replace(/\s/g, "")}`} class="micro">{profile.contact.phone}</a>}
      <ul class="socials">
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noopener" class="social">
                <span class="heading">{s.label}</span>
                <ArrowUpRight size={20} aria-hidden="true" />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="micro text-muted">{profile.location.city}, {profile.location.region}, {profile.location.country} · {profile.location.coords}</p>
    </div>

    <form class="col-span-4 md:col-span-6 md:col-start-7 form" data-contact-form data-email={profile.contact.email} novalidate>
      <div class="field">
        <label for="name" class="micro">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
      </div>
      <div class="field">
        <label for="email" class="micro">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="200" required />
      </div>
      <div class="field">
        <label for="message" class="micro">Message</label>
        <textarea id="message" name="message" rows="6" maxlength="5000" required></textarea>
      </div>
      <!-- Honeypot: hidden from people; bots that fill it are dropped server-side. -->
      <div class="hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <!-- Cloudflare Turnstile: usually invisible; shows a checkbox only if unsure. -->
      {turnstileKey && <div class="turnstile" data-turnstile data-sitekey={turnstileKey}></div>}
      <p class="micro form-error" role="alert" data-form-error hidden></p>
      <p class="form-done" role="status" data-form-done hidden>Thanks — your message is on its way. I'll reply soon.</p>
      <button type="submit" class="micro submit" data-liquid data-submit>Send message →</button>
    </form>
  </section>
  </div>
</BaseLayout>


{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

<script>
  // Sends through POST /api/contact (Turnstile-checked, emailed via Cloudflare Email Service).
  // If the backend isn't set up yet or sending fails, it opens the visitor's mail app instead.
  type Turnstile = {
    render: (el: HTMLElement, o: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };
  const ts = () => (window as unknown as { turnstile?: Turnstile }).turnstile;

  function setupContact() {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const error = document.querySelector<HTMLElement>("[data-form-error]");
    const done = document.querySelector<HTMLElement>("[data-form-done]");
    const button = document.querySelector<HTMLButtonElement>("[data-submit]");
    const box = document.querySelector<HTMLElement>("[data-turnstile]");
    if (!form || !error || !done || !button) return;

    // Turnstile is optional: without a site key (before launch setup) there is no widget,
    // the server answers "fallback" and the visitor's mail app opens instead.
    let widget: string | null = null;
    let token = "";
    // The visitor may press Send before Turnstile has finished its (invisible) check:
    // wait up to ~8 s for the token instead of sending an empty one.
    const waitForToken = async () => {
      for (let i = 0; i < 40 && !token; i++) {
        const t = widget !== null ? ts()?.getResponse(widget) : undefined;
        if (t) token = t;
        else await new Promise((r) => setTimeout(r, 200));
      }
      return token;
    };
    if (box) {
      const mount = () => {
        const t = ts();
        if (!t || widget !== null || !box.isConnected) return;
        widget = t.render(box, {
          sitekey: box.dataset.sitekey,
          appearance: "interaction-only",
          theme: "auto",
          action: "contact",
          callback: (tok: string) => (token = tok),
          "expired-callback": () => (token = ""),
          "error-callback": () => (token = ""),
        });
      };
      // The script loads async: try now, and poll briefly until it is ready.
      mount();
      const wait = window.setInterval(() => (widget !== null || !box.isConnected ? clearInterval(wait) : mount()), 300);
    }

    const fail = (msg: string) => {
      error.textContent = msg;
      error.hidden = false;
    };
    const mailto = (name: string, email: string, message: string) => {
      const subject = encodeURIComponent(`Portfolio enquiry from ${name}`);
      const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    };

    form.onsubmit = async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();
      const missing = [!name && "name", !/^\S+@\S+\.\S+$/.test(email) && "a valid email", message.length < 10 && "a message (10+ characters)"].filter(Boolean);
      if (missing.length) return fail(`Please add ${missing.join(", ")}.`);
      error.hidden = true;

      button.disabled = true;
      button.textContent = "Sending…";
      const sendToken = box ? await waitForToken() : undefined;
      try {
        const r = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name, email, message, token: sendToken, website: data.get("website") }),
        });
        const out = (await r.json().catch(() => ({}))) as { ok?: boolean; error?: string; fallback?: string };
        if (out.ok) {
          form.reset();
          done.hidden = false;
          button.hidden = true;
          return;
        }
        if (out.fallback === "mailto") return mailto(name, email, message);
        fail(out.error ?? "Something went wrong. Please try again.");
      } catch {
        // Offline / network error: the mail app still works.
        mailto(name, email, message);
      } finally {
        button.disabled = false;
        if (!button.hidden) button.textContent = "Send message →";
        if (widget !== null) {
          token = ""; // a token is single-use: get a fresh one for the next send
          ts()?.reset(widget);
        }
      }
    };
  }
  document.addEventListener("astro:page-load", setupContact);
</script>

<style>
  .contact {
    row-gap: 64px;
    padding-bottom: clamp(64px, 10vw, 160px);
    border-top: 1px solid var(--line-strong);
    padding-top: 40px;
  }
  .details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .email {
    font-size: clamp(1.4rem, 0.6rem + 1.9vw, 2.4rem);
    width: fit-content;
    overflow-wrap: anywhere;
  }
  .socials {
    list-style: none;
    margin: 16px 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .social {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-lead);
  }
  .social:hover {
    padding-left: 8px;
    transition: padding var(--dur) var(--ease-out);
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  input,
  textarea {
    font: inherit;
    font-size: var(--text-lead);
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    padding: 8px 0;
    border-radius: 0;
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--orange);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-done {
    margin: 0;
    font-size: var(--text-lead);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .form-error {
    margin: 0;
    color: #b42318;
  }
  .submit {
    align-self: flex-start;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--fg);
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .submit:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--charcoal);
  }
  /* Painted storm-cloud forest (Praveen's image), drifting very slowly behind the page. */
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .sky-img {
    position: absolute;
    inset: -6%;
    /* Praveen's painting: portrait art on phones, the wide forest-meadow version on laptops. */
    background: url("/media/contact-portrait.webp") center 70% / cover no-repeat;
    animation: sky-drift 70s ease-in-out infinite alternate;
  }
  @media (min-width: 768px) {
    .sky-img {
      background-image: url("/media/contact-wide.webp");
      background-position: center 60%;
    }
  }
  /* soft paper veil at the top so the title and form stay crisp */
  .sky::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in oklab, var(--bg) 55%, transparent) 0%, color-mix(in oklab, var(--bg) 15%, transparent) 45%, color-mix(in oklab, var(--bg) 35%, transparent) 100%);
  }
  @keyframes sky-drift {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.1) translate(-2%, -3%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky-img { animation: none; }
  }
  .over-sky {
    position: relative;
    z-index: 1;
  }
  /* Details + form sit on frosted glass so they read over the painting. */
  .over-sky .contact {
    margin-bottom: clamp(32px, 5vw, 64px);
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid color-mix(in oklab, var(--fg) 12%, transparent);
    border-radius: 24px;
    background: color-mix(in oklab, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
  }
</style>
