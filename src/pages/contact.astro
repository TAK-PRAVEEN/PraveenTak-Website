---
import { getEntry } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import StatusDot from "../components/ui/StatusDot.astro";
import RefSequence from "../components/3d/RefSequence.astro";
import HudDial from "../components/3d/HudDial.astro";


const profile = (await getEntry("profile", "main"))!.data;
// Turnstile site key is public. Set PUBLIC_TURNSTILE_SITE_KEY at build time for production.
// Local dev uses Cloudflare's documented always-pass TEST key; a production build without a
// real key renders no widget (the form then falls back to the visitor's mail app).
// Production site key (public by design) for praveentak.dev / www / workers.dev.
const TURNSTILE_SITE_KEY = "0x4AAAAAAF7pn6An_FhJYhzE";
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? "1x00000000000000000000AA" : TURNSTILE_SITE_KEY);
---

<BaseLayout title="Contact" fullTitle="Contact Praveen Tak — AI/ML Engineer for Hire" section="/contact" description="Contact Praveen Tak, AI/ML engineer and full-stack developer in Jaipur, India — for AI/ML roles, freelance products and collaborations. Email or message." bare>
  <div class="sky" aria-hidden="true"><div class="sky-img"></div></div>
  <div class="over-sky">
  <PageHeader section="/contact" title="Let's talk"><RefSequence slot="visual" name="sphere" frames={90} fps={25} /></PageHeader>

  <section class="frame bento" aria-label="Contact">
    <!-- 01 Email -->
    <div class="tile tile-mail glass">
      <p class="micro tile-k">01 — Email</p>
      <a href={`mailto:${profile.contact.email}`} class="mail-big link-underline">{profile.contact.email}</a>
      <div class="tile-foot">
        <StatusDot open={profile.availability.open} label={profile.availability.label} />
        <button type="button" class="pill micro" data-copy={profile.contact.email}>Copy address</button>
      </div>
    </div>

    <!-- 02 Phone -->
    <div class="tile tile-phone glass">
      <p class="micro tile-k">02 — Phone</p>
      {profile.contact.phone && <p class="phone-big">{profile.contact.phone}</p>}
      <div class="tile-foot">
        {profile.contact.phone && <a class="pill pill-solid micro" href={`tel:${profile.contact.phone.replace(/\s/g, "")}`}>Call</a>}
        {profile.contact.phone && <a class="pill micro" href={`https://wa.me/${profile.contact.phone.replace(/[^0-9]/g, "")}`} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>}
      </div>
    </div>

    <!-- puzzle joint where the four tiles meet -->
    <a class="joint" href="/card" aria-label="Open my digital business card" title="My contact card"><ArrowUpRight size={26} aria-hidden="true" /></a>

    <!-- 03 Message -->
    <div class="tile tile-form glass">
      <p class="micro tile-k">03 — Message</p>
      <h2 class="tile-h">Tell me about your project.</h2>
        <form class="form" data-contact-form data-email={profile.contact.email} novalidate>
          <div class="field">
            <label for="name" class="micro">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required />
          </div>
          <div class="field">
            <label for="email" class="micro">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="200" required />
          </div>
          <div class="field">
            <label for="message" class="micro">Message</label>
            <textarea id="message" name="message" rows="6" maxlength="5000" required></textarea>
          </div>
          <!-- Honeypot: hidden from people; bots that fill it are dropped server-side. -->
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <!-- Cloudflare Turnstile: usually invisible; shows a checkbox only if unsure. -->
          {turnstileKey && <div class="turnstile" data-turnstile data-sitekey={turnstileKey}></div>}
          <p class="micro form-error" role="alert" data-form-error hidden></p>
          <p class="form-done" role="status" data-form-done hidden>Thanks — your message is on its way. I'll reply soon.</p>
          <button type="submit" class="micro submit" data-liquid data-submit>Send message →</button>
        </form>
    </div>

    <!-- 04 Where I am -->
    <div class="tile tile-dial glass">
      <p class="micro tile-k">04 — Where I am, right now</p>
      <p class="micro text-muted">{profile.location.city}, {profile.location.region}, {profile.location.country} · {profile.location.coords}</p>
      <div class="dial-wrap"><HudDial size="min(500px, 100%)" label="Live Earth clock centred on Jaipur — drag to spin" /></div>
    </div>

    <!-- 05–07 Links -->
    <ul class="socials">
      {
        profile.socials.map((s, i) => (
          <li>
            <a href={s.href} target="_blank" rel="me noopener" class="social glass">
              <span class="social-top">
                <span class="micro social-idx">0{i + 5}</span>
                <span class="social-go" aria-hidden="true"><ArrowUpRight size={18} /></span>
              </span>
              <span class="social-label">{s.label}</span>
              <span class="micro social-handle">{s.href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  </div>
</BaseLayout>


{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}

<script>
  // Sends through POST /api/contact (Turnstile-checked, emailed via Cloudflare Email Service).
  // If the backend isn't set up yet or sending fails, it opens the visitor's mail app instead.
  type Turnstile = {
    render: (el: HTMLElement, o: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };
  const ts = () => (window as unknown as { turnstile?: Turnstile }).turnstile;

  function setupContact() {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    const error = document.querySelector<HTMLElement>("[data-form-error]");
    const done = document.querySelector<HTMLElement>("[data-form-done]");
    const button = document.querySelector<HTMLButtonElement>("[data-submit]");
    const box = document.querySelector<HTMLElement>("[data-turnstile]");
    if (!form || !error || !done || !button) return;

    // Turnstile is optional: without a site key (before launch setup) there is no widget,
    // the server answers "fallback" and the visitor's mail app opens instead.
    let widget: string | null = null;
    let token = "";
    // The visitor may press Send before Turnstile has finished its (invisible) check,
    // which can take several seconds: wait up to ~20 s for the token, never send without one.
    const waitForToken = async () => {
      for (let i = 0; i < 100 && !token; i++) {
        const t = widget !== null ? ts()?.getResponse(widget) : undefined;
        if (t) token = t;
        else await new Promise((r) => setTimeout(r, 200));
      }
      return token;
    };
    if (box) {
      const mount = () => {
        const t = ts();
        if (!t || widget !== null || !box.isConnected) return;
        widget = t.render(box, {
          sitekey: box.dataset.sitekey,
          appearance: "interaction-only",
          theme: "auto",
          action: "contact",
          callback: (tok: string) => (token = tok),
          "expired-callback": () => (token = ""),
          "error-callback": () => (token = ""),
        });
      };
      // The script loads async: try now, and poll briefly until it is ready.
      mount();
      const wait = window.setInterval(() => (widget !== null || !box.isConnected ? clearInterval(wait) : mount()), 300);
    }

    const fail = (msg: string) => {
      error.textContent = msg;
      error.hidden = false;
    };
    const mailto = (name: string, email: string, message: string) => {
      const subject = encodeURIComponent(`Portfolio enquiry from ${name}`);
      const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    };

    form.onsubmit = async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();
      const missing = [!name && "name", !/^\S+@\S+\.\S+$/.test(email) && "a valid email", message.length < 10 && "a message (10+ characters)"].filter(Boolean);
      if (missing.length) return fail(`Please add ${missing.join(", ")}.`);
      error.hidden = true;

      button.disabled = true;
      button.textContent = box && !token ? "Verifying…" : "Sending…";
      const sendToken = box ? await waitForToken() : undefined;
      if (box && !sendToken) {
        button.disabled = false;
        button.textContent = "Send message →";
        return fail("Still checking you're human — please wait a moment and press Send again.");
      }
      button.textContent = "Sending…";
      try {
        const r = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name, email, message, token: sendToken, website: data.get("website") }),
        });
        const out = (await r.json().catch(() => ({}))) as { ok?: boolean; error?: string; fallback?: string };
        if (out.ok) {
          form.reset();
          done.hidden = false;
          button.hidden = true;
          return;
        }
        if (out.fallback === "mailto") return mailto(name, email, message);
        fail(out.error ?? "Something went wrong. Please try again.");
      } catch {
        // Offline / network error: the mail app still works.
        mailto(name, email, message);
      } finally {
        button.disabled = false;
        if (!button.hidden) button.textContent = "Send message →";
        if (widget !== null) {
          token = ""; // a token is single-use: get a fresh one for the next send
          ts()?.reset(widget);
        }
      }
    };
  }
  document.addEventListener("astro:page-load", setupContact);
  // "Copy address" on the email tile.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
      b.onclick = async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = "Copied ✓"; }
        catch { location.href = `mailto:${b.dataset.copy}`; }
        setTimeout(() => (b.textContent = "Copy address"), 1800);
      };
    });
  });
</script>

<style>
  /* Bento "puzzle" of glass tiles: email | phone, message | live dial, then three links.
     The four upper tiles have a round notch where they meet; the joint button sits in it. */
  .bento {
    --gap: 16px; --notch: 50px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap);
    padding-top: 32px;
    padding-bottom: clamp(64px, 10vw, 160px);
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 2.4vw, 36px);
    border-radius: 32px;
    min-width: 0;
  }
  .tile-k { opacity: 0.6; margin: 0; }
  .tile-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: auto; }
  .tile-mail { grid-column: 1 / 8; grid-row: 1; min-height: 240px; }
  .tile-phone { grid-column: 8 / 13; grid-row: 1; }
  .tile-form { grid-column: 1 / 8; grid-row: 2; }
  .tile-dial { grid-column: 8 / 13; grid-row: 2; }
  .socials { grid-column: 1 / -1; grid-row: 3; }
  .joint { display: none; }
  @media (min-width: 900px) {
    .tile-mail { -webkit-mask: radial-gradient(circle at 100% 100%, transparent var(--notch), #000 calc(var(--notch) + 1px)); mask: radial-gradient(circle at 100% 100%, transparent var(--notch), #000 calc(var(--notch) + 1px)); }
    .tile-phone { -webkit-mask: radial-gradient(circle at 0% 100%, transparent var(--notch), #000 calc(var(--notch) + 1px)); mask: radial-gradient(circle at 0% 100%, transparent var(--notch), #000 calc(var(--notch) + 1px)); }
    .tile-form { -webkit-mask: radial-gradient(circle at 100% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px)); mask: radial-gradient(circle at 100% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px)); }
    .tile-dial { -webkit-mask: radial-gradient(circle at 0% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px)); mask: radial-gradient(circle at 0% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px)); }
    .joint {
      grid-column: 7 / 9; grid-row: 1;
      justify-self: center; align-self: end;
      margin-bottom: calc(-1 * (var(--gap) / 2) - 38px);
      z-index: 2;
      width: 76px; height: 76px; border-radius: 50%;
      display: grid; place-items: center;
      background: var(--fg); color: var(--bg);
      box-shadow: 0 14px 30px rgb(0 0 0 / 0.3), inset 0 1px 0 rgb(255 255 255 / 0.25);
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .joint:hover { transform: rotate(45deg) scale(1.06); }
    .joint:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  }
  /* Phones / tablets: the same puzzle, stacked. Email and phone sit side by side on a
     2-column grid; the joint button locks the phone tile and the message tile together
     (round notch in each), then the dial and the three links. */
  @media (max-width: 899px) {
    .bento { --gap: 12px; --notch: 40px; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-top: 20px; }
    .tile { padding: 18px; border-radius: 26px; gap: 12px; }
    .tile-mail { grid-column: 1 / -1; grid-row: auto; min-height: 0; }
    .tile-phone { grid-column: 1 / -1; grid-row: auto;
      -webkit-mask: radial-gradient(circle at 50% 100%, transparent var(--notch), #000 calc(var(--notch) + 1px));
      mask: radial-gradient(circle at 50% 100%, transparent var(--notch), #000 calc(var(--notch) + 1px)); }
    .tile-form { grid-column: 1 / -1; grid-row: auto;
      -webkit-mask: radial-gradient(circle at 50% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px));
      mask: radial-gradient(circle at 50% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px)); }
    .tile-dial, .socials { grid-column: 1 / -1; grid-row: auto; }
    .tile-form .tile-k { padding-top: 24px; }
    .joint {
      display: grid; place-items: center;
      grid-column: 1 / -1; justify-self: center;
      width: 62px; height: 62px; border-radius: 50%;
      margin: calc(-31px - var(--gap) / 2) 0;
      z-index: 2; position: relative;
      background: var(--fg); color: var(--bg);
      box-shadow: 0 10px 24px rgb(0 0 0 / 0.3), inset 0 1px 0 rgb(255 255 255 / 0.25);
    }
    .mail-big { font-size: clamp(1.45rem, 7.2vw, 2.2rem); }
    .phone-big { font-size: clamp(1.45rem, 7.2vw, 2.2rem); }
    .tile-foot { margin-top: 4px; gap: 10px; }
    .pill { min-height: 40px; padding: 0 16px; }
    .tile-h { font-size: clamp(1.4rem, 6.4vw, 2rem); }
    .dial-wrap { padding: 8px 0 40px; }
  }
  .mail-big {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.6rem, 0.6rem + 3vw, 3.4rem); letter-spacing: -0.035em; line-height: 1;
    width: fit-content; overflow-wrap: anywhere;
  }
  .phone-big { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 0.8rem + 2.2vw, 2.8rem); letter-spacing: -0.03em; line-height: 1; }
  .tile-h { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 1rem + 1.6vw, 2.6rem); letter-spacing: -0.03em; line-height: 1.02; }
  .pill {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    border-radius: 999px; border: 1px solid var(--line-strong);
    background: transparent; color: var(--fg); font: inherit; cursor: pointer; text-decoration: none;
  }
  .pill-solid { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .dial-wrap { display: grid; place-items: center; padding: 24px 0 48px; }

  /* Links: three frosted-glass tabs in one row. */
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .social {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 170px;
    padding: 22px 22px 24px;
    border-radius: 32px;
    color: var(--fg);
    text-decoration: none;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .social:hover { transform: translateY(-4px); }
  .social:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .social-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: auto; }
  .social-idx { opacity: 0.6; }
  .social-go {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--fg); color: var(--bg);
    box-shadow: 0 6px 14px rgb(0 0 0 / 0.25), inset 0 1px 0 rgb(255 255 255 / 0.3);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .social:hover .social-go { transform: rotate(45deg); }
  .social-label { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 0.8rem + 1.2vw, 2.2rem); letter-spacing: -0.03em; line-height: 1; }
  .social-handle { opacity: 0.55; overflow-wrap: anywhere; }
  @media (max-width: 560px) {
    .social { min-height: 120px; padding: 14px; border-radius: 22px; }
    .social-handle { display: none; }
    .social-go { width: 34px; height: 34px; }
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  input,
  textarea {
    font: inherit;
    font-size: var(--text-lead);
    color: var(--fg);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    padding: 8px 0;
    border-radius: 0;
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--orange);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-done {
    margin: 0;
    font-size: var(--text-lead);
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .form-error {
    margin: 0;
    color: #b42318;
  }
  .submit {
    align-self: flex-start;
    min-height: 48px;
    padding: 0 22px;
    border: 1px solid var(--fg);
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .submit:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--charcoal);
  }
  /* Painted storm-cloud forest (Praveen's image), drifting very slowly behind the page. */
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .sky-img {
    position: absolute;
    inset: -6%;
    /* Praveen's painting: portrait art on phones, the wide forest-meadow version on laptops. */
    background: url("/media/contact-portrait.webp") center 70% / cover no-repeat;
    animation: sky-drift 70s ease-in-out infinite alternate;
  }
  @media (min-width: 768px) {
    .sky-img {
      background-image: url("/media/contact-wide.webp");
      background-position: center 60%;
    }
  }
  /* soft paper veil at the top so the title and form stay crisp */
  .sky::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in oklab, var(--bg) 55%, transparent) 0%, color-mix(in oklab, var(--bg) 15%, transparent) 45%, color-mix(in oklab, var(--bg) 35%, transparent) 100%);
  }
  @keyframes sky-drift {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.1) translate(-2%, -3%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sky-img { animation: none; }
  }
  .over-sky {
    position: relative;
    z-index: 1;
  }
</style>
