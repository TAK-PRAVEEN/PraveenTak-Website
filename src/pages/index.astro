---
import { getCollection, getEntry } from "astro:content";
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusDot from "../components/ui/StatusDot.astro";
import LinkButton from "../components/ui/LinkButton.astro";
import Signature from "../components/motion/Signature.astro";
import BinaryPortrait from "../components/3d/BinaryPortrait.astro";
import { EXPERIENCES, SITE } from "../config/site";

const profile = (await getEntry("profile", "main"))!.data;
const featured = (await getCollection("projects", (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const chapters = EXPERIENCES.filter((e) => e.href !== "/");
---

<BaseLayout section="/">
  <!-- 01 — HERO ----------------------------------------------------------- -->
  <section id="hero" class="hero frame" aria-labelledby="hero-title">
    <div class="hero-meta micro">
      <span>01 — Portfolio {SITE.year}</span>
      <span class="text-muted">{profile.location.coords}</span>
      <StatusDot open={profile.availability.open} label={profile.availability.label} />
    </div>
    <hr class="rule-strong" />

    <div class="grid-12 hero-grid">
      <div class="hero-copy col-span-4 md:col-span-7">
        <p class="micro text-muted hero-hi" data-hero-fade>Hi, I'm</p>
        <!-- One name only: the signature is the visible name; the h1 text is for SEO / screen readers. -->
        <h1 id="hero-title" class="hero-name" data-hero-name>
          <span class="sr-only">Praveen Tak</span>
          <Signature class="hero-signature" />
        </h1>
        <ul class="roles" aria-label="Roles" data-hero-fade>
          {profile.roles.map((r, i) => <li class="micro"><span class="text-muted">0{i + 1}</span> {r}</li>)}
        </ul>
      </div>

      <BinaryPortrait class="hero-portrait col-span-4 md:col-span-5" scrollTarget="#hero" />
    </div>

    <div class="grid-12 hero-foot">
      <p class="hero-intro col-span-4 md:col-span-6">{profile.intro}</p>
      <div class="hero-actions col-span-4 md:col-span-5 md:col-start-8">
        <LinkButton href="/work">Selected work</LinkButton>
        <LinkButton href="/contact" variant="outline">Get in touch</LinkButton>
      </div>
    </div>
  </section>

  <!-- PAPER → INK: scroll transition out of the hero ----------------------- -->
  <section class="band" data-surface="ink" data-accent="orange" data-band aria-labelledby="statement">
    <div class="band-ink" data-band-ink aria-hidden="true"></div>
    <div class="frame band-inner" data-band-inner>
      <div class="band-meta micro">
        <span>01.1 — Statement</span>
        <span class="text-muted">{profile.location.coords}</span>
      </div>
      <!-- Slot for Praveen's own one-liner (pending); falls back to the brief's statement. -->
      <p id="statement" class="editorial band-statement" data-band-statement>{profile.statement}</p>
      <ul class="band-pillars micro" aria-label="Disciplines">
        <li><span class="band-index">A</span> AI / ML engineering</li>
        <li><span class="band-index">B</span> Full-stack systems</li>
        <li><span class="band-index">C</span> Creative technology</li>
      </ul>
    </div>
  </section>

  <!-- INDEX OF EXPERIENCES ------------------------------------------------- -->
  <section class="frame chapters" aria-labelledby="chapters-title">
    <div class="section-meta micro">
      <h2 id="chapters-title">Index</h2>
      <span class="text-muted">{chapters.length} chapters</span>
    </div>
    <ol class="chapter-list">
      {
        chapters.map((c) => (
          <li>
            <a href={c.href} class="chapter" data-liquid>
              <span class="micro chapter-index">{c.index}</span>
              <span class="heading chapter-label">{c.label}</span>
              <span class="chapter-summary">{c.summary}</span>
              <ArrowUpRight class="chapter-arrow" size={28} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- FEATURED WORK -------------------------------------------------------- -->
  <section class="frame featured" aria-labelledby="featured-title">
    <div class="section-meta micro">
      <h2 id="featured-title">Selected work</h2>
      <a href="/work" class="link-underline">All projects →</a>
    </div>
    <div class="grid-12 featured-grid">
      {
        featured.map((p, i) => (
          <a href={`/work/${p.id}`} class="feature col-span-4">
            <span class="micro text-muted">P—0{i + 1}</span>
            <h3 class="heading feature-title">{p.data.title}</h3>
            <p class="feature-summary">{p.data.summary}</p>
            {p.data.metrics[0] && (
              <p class="feature-metric">
                <span class="display">{p.data.metrics[0].value}</span>
                <span class="micro text-muted">{p.data.metrics[0].label}</span>
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  let cleanup: (() => void) | null = null;
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector("[data-band]")) return;
    const { initHomeMotion } = await import("../components/motion/home-motion");
    cleanup?.();
    cleanup = initHomeMotion();
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: calc(var(--nav-h) + 24px);
    /* One screen tall, but never stretched on very tall displays. */
    min-height: min(100svh, 1080px);
    display: flex;
    flex-direction: column;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 12px;
  }
  .hero-grid {
    flex: 1;
    align-items: center;
    padding-block: clamp(24px, 4vw, 48px);
    row-gap: 32px;
  }
  .hero-hi {
    margin: 0 0 8px;
  }
  /* The signature IS the name: giant, the hero's main typographic statement. */
  .hero-name {
    margin: 0;
  }
  .hero-name :global(.hero-signature) {
    width: min(100%, 880px);
    margin-left: -1.5%;
  }

  /* ---- Paper → Ink statement band ---- */
  .band {
    position: relative;
    isolation: isolate;
    color: var(--fg);
    margin-top: clamp(48px, 8vw, 120px);
  }
  /* The ink layer is wiped in on scroll (clip-path); without JS it is simply there. */
  .band-ink {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--band-bg, var(--ink));
  }
  .band-inner {
    min-height: min(100svh, 980px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-block: clamp(48px, 7vw, 96px);
  }
  .band-meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .band-statement {
    margin: 0;
    font-size: clamp(3.5rem, 1rem + 10vw, 12rem);
    line-height: 0.92;
    max-width: 12ch;
  }
  .band-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    list-style: none;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
  }
  .band-index {
    color: var(--accent-as-text);
    margin-right: 8px;
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    list-style: none;
    margin: clamp(20px, 3vw, 40px) 0 0;
    padding: 0;
  }

  .hero-grid :global(.hero-portrait) {
    max-width: 540px;
    justify-self: center;
  }

  .hero-foot {
    padding-block: 24px 40px;
    border-top: 1px solid var(--line);
    row-gap: 24px;
    align-items: end;
  }
  .hero-intro {
    margin: 0;
    font-size: var(--text-lead);
    line-height: 1.45;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-start;
  }
  @media (min-width: 768px) {
    .hero-actions {
      justify-content: flex-end;
    }
  }

  /* ---- Shared section meta ---- */
  .section-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .section-meta h2 {
    font: inherit;
    margin: 0;
  }

  /* ---- Chapters ---- */
  .chapters {
    padding-block: clamp(64px, 10vw, 160px) 0;
  }
  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chapter {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 8px 16px;
    padding: clamp(16px, 2vw, 28px) 8px;
    border-bottom: 1px solid var(--line);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      padding var(--dur) var(--ease-out);
  }
  .chapter-label {
    font-size: clamp(2rem, 1rem + 4vw, 4.5rem);
  }
  .chapter-summary {
    grid-column: 2;
    color: var(--fg-muted);
  }
  .chapter :global(.chapter-arrow) {
    grid-column: 3;
    grid-row: 1;
    transition: transform var(--dur) var(--ease-out);
  }
  @media (min-width: 768px) {
    .chapter {
      grid-template-columns: 80px minmax(0, 5fr) minmax(0, 4fr) auto;
    }
    .chapter-summary {
      grid-column: 3;
    }
    .chapter :global(.chapter-arrow) {
      grid-column: 4;
    }
  }
  .chapter:hover,
  .chapter:focus-visible {
    background: var(--fg);
    color: var(--bg);
    padding-inline: 24px;
  }
  .chapter:hover .chapter-summary,
  .chapter:focus-visible .chapter-summary {
    color: color-mix(in oklab, var(--bg) 75%, var(--fg));
  }
  .chapter:hover :global(.chapter-arrow) {
    transform: rotate(45deg);
  }

  /* ---- Featured ---- */
  .featured {
    padding-top: clamp(64px, 10vw, 160px);
  }
  .featured-grid {
    row-gap: 0;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 0 32px;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .feature {
      padding: 24px 24px 32px 0;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .feature:last-child {
      border-right: 0;
    }
  }
  .feature-title {
    font-size: var(--text-h3);
    margin: 0;
  }
  .feature:hover .feature-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .feature-summary {
    margin: 0;
    color: var(--fg-muted);
  }
  .feature-metric {
    margin: auto 0 0;
    padding-top: 24px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .feature-metric .display {
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
  }
</style>
