---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusDot from "../components/ui/StatusDot.astro";
import LinkButton from "../components/ui/LinkButton.astro";
import Signature from "../components/motion/Signature.astro";
import BinaryPortrait from "../components/3d/BinaryPortrait.astro";
import WindowScene from "../components/home/WindowScene.astro";
import StackedWork from "../components/home/StackedWork.astro";
import ChapterStrip from "../components/home/ChapterStrip.astro";
import BigNumbers from "../components/home/BigNumbers.astro";
import ToolkitWall from "../components/home/ToolkitWall.astro";
import Intro from "../components/motion/Intro.astro";
import RefSequence from "../components/3d/RefSequence.astro";
import { SITE } from "../config/site";

const profile = (await getEntry("profile", "main"))!.data;
// Statement typography: bold display words, the last word hand-written in script.
const statementWords = (profile.statement ?? "").trim().split(/\s+/);
const statementLast = statementWords.pop() ?? "";
const statementLead = statementWords.join(" ");
---

<BaseLayout section="/">
  <Intro />
  <!-- 01 — HERO ----------------------------------------------------------- -->
  <section id="hero" class="hero frame" aria-labelledby="hero-title">
    <div class="hero-meta micro">
      <span data-decode>01 — Portfolio {SITE.year}</span>
      <span class="text-muted">{profile.location.coords}</span>
      <StatusDot open={profile.availability.open} label={profile.availability.label} />
    </div>
    <hr class="rule-strong" />

    <div class="grid-12 hero-grid">
      <div class="hero-copy col-span-4 md:col-span-7">
        <p class="micro text-muted hero-hi" data-hero-fade>Hi, I'm</p>
        <!-- One name only: the signature is the visible name; the h1 text is for SEO / screen readers. -->
        <h1 id="hero-title" class="hero-name" data-hero-name>
          <span class="sr-only">Praveen Tak</span>
          <Signature class="hero-signature" />
        </h1>
        <!-- Role in the Valorant face: small, with an occasional digital glitch. -->
        <div data-hero-fade><p class="hero-role" data-text="AI / ML ENGINEER">AI / ML ENGINEER</p></div>
        <ul class="roles" aria-label="Roles" data-hero-fade>
          {profile.roles.map((r, i) => <li class="micro"><span class="text-muted">0{i + 1}</span> {r}</li>)}
        </ul>
        <!-- Intro + actions sit under the name in the left column (saves a whole row). -->
        <p class="hero-intro" data-hero-fade>{profile.intro}</p>
        <div class="hero-actions" data-hero-fade>
          <LinkButton href="/work">Selected work</LinkButton>
          <LinkButton href="/contact" variant="outline">Get in touch</LinkButton>
        </div>
      </div>

      <BinaryPortrait class="hero-portrait col-span-4 md:col-span-5" scrollTarget="#hero" />
    </div>

  </section>

  <!-- PAPER → INK: scroll transition out of the hero ----------------------- -->
  <section class="band" data-surface="ink" data-accent="orange" data-band aria-labelledby="statement">
    <div class="band-ink" data-band-ink data-ink-dark aria-hidden="true"></div>
    <div class="band-disc" data-band-disc aria-hidden="true"></div>
    <div class="band-moon" data-band-moon aria-hidden="true"><RefSequence name="moon" frames={225} fps={15} plain /></div>
    <div class="frame band-inner" data-band-inner>
      <div class="band-meta micro">
        <span data-decode>01.1 — Statement</span>
        <span class="text-muted">{profile.location.coords}</span>
      </div>
      <!-- Slot for Praveen's own one-liner (pending); falls back to the brief's statement. -->
      <p id="statement" class="band-statement" data-band-statement>
        <span class="display band-lead">{statementLead}</span>
        <span class="script script-bold band-script">{statementLast}</span>
      </p>
      <ul class="band-pillars micro" aria-label="Disciplines">
        <li><span class="band-index">A</span> AI / ML engineering</li>
        <li><span class="band-index">B</span> Full-stack systems</li>
        <li><span class="band-index">C</span> Creative technology</li>
      </ul>
    </div>
  </section>

  <!-- SCENES (home film): window → rotating sculpture, stacked work, sideways index, numbers -->
  <!-- Paper interlude: toolkit wall + key figures, between the band and the window scene. -->
  <ToolkitWall />

  <WindowScene />
  <StackedWork />
  <ChapterStrip />
  <BigNumbers />
</BaseLayout>

<script>
  let cleanup: (() => void) | null = null;
  document.addEventListener("astro:page-load", async () => {
    if (!document.querySelector("[data-band]")) return;
    const { initHomeMotion } = await import("../components/motion/home-motion");
    cleanup?.();
    cleanup = initHomeMotion();
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: calc(var(--nav-h) + 24px);
    /* One screen tall, but never stretched on very tall displays. */
    min-height: min(88svh, 960px);
    display: flex;
    flex-direction: column;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 12px;
  }
  .hero-grid {
    align-items: center;
    padding-block: clamp(16px, 2.5vw, 32px) clamp(8px, 1.5vw, 16px);
    row-gap: 32px;
  }
  .hero-hi {
    margin: 0 0 8px;
  }
  /* The signature IS the name: giant, the hero's main typographic statement. */
  .hero-name {
    margin: 0;
  }
  .hero-name :global(.hero-signature) {
    width: min(100%, 880px);
    margin-left: -1.5%;
  }

  /* ---- Paper → Ink statement band ---- */
  .band {
    position: relative;
    isolation: isolate;
    /* the moon disc may rise above the band, but nothing may widen the page sideways
       (phones zoom the whole page out when anything sticks out) */
    overflow-x: clip;
    color: var(--fg);
    margin-top: clamp(48px, 8vw, 120px);
  }
  /* The ink layer is wiped in on scroll (clip-path); without JS it is simply there. */
  .band-ink {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--band-bg, var(--ink));
  }
  .band-inner {
    min-height: min(100svh, 980px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-block: clamp(48px, 7vw, 96px);
  }
  .band-meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .band-statement {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .band-lead {
    font-size: clamp(3.25rem, 1rem + 9vw, 10.5rem);
    line-height: 0.9;
    max-width: 10ch;
  }
  .band-script {
    font-size: clamp(3.75rem, 1rem + 10vw, 12rem);
    line-height: 0.95;
    color: var(--accent-as-text);
    margin: -0.08em 0 0 0.12em;
  }
  .band-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    list-style: none;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
  }
  .band-index {
    color: var(--accent-as-text);
    margin-right: 8px;
  }
  /* Small Valorant role line. Two offset copies (accent + cyan) flicker in sliced
     bursts for a fraction of a second every few seconds; the real text stays put. */
  .hero-role {
    position: relative;
    width: fit-content;
    margin: clamp(16px, 2.4vw, 28px) 0 0;
    font-family: "Valorant", var(--font-display);
    font-size: clamp(1.05rem, 0.7rem + 1.3vw, 1.75rem);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--fg);
    animation: role-jitter 5.2s steps(1) infinite;
  }
  .hero-role::before,
  .hero-role::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }
  .hero-role::before {
    color: var(--orange);
    animation: role-glitch-a 5.2s steps(1) infinite;
  }
  .hero-role::after {
    color: var(--cyan);
    mix-blend-mode: multiply;
    animation: role-glitch-b 5.2s steps(1) infinite;
  }
  :global(:root[data-theme="dark"]) .hero-role::after {
    mix-blend-mode: screen;
  }
  @keyframes role-jitter {
    0%, 88%, 100% { transform: none; }
    89% { transform: translateX(2px) skewX(-8deg); }
    91% { transform: translateX(-2px); }
    93% { transform: skewX(6deg); }
    95% { transform: none; }
    97% { transform: translateX(1px); }
  }
  @keyframes role-glitch-a {
    0%, 88%, 99%, 100% { opacity: 0; clip-path: inset(0 0 0 0); transform: none; }
    89% { opacity: 1; clip-path: inset(10% 0 62% 0); transform: translate(-4px, -1px); }
    91% { opacity: 1; clip-path: inset(58% 0 12% 0); transform: translate(5px, 1px); }
    93% { opacity: 1; clip-path: inset(30% 0 40% 0); transform: translate(-3px, 0); }
    95% { opacity: 1; clip-path: inset(75% 0 2% 0); transform: translate(3px, 0); }
    97% { opacity: 1; clip-path: inset(0 0 80% 0); transform: translate(-2px, 0); }
  }
  @keyframes role-glitch-b {
    0%, 88%, 99%, 100% { opacity: 0; clip-path: inset(0 0 0 0); transform: none; }
    89% { opacity: 1; clip-path: inset(48% 0 22% 0); transform: translate(4px, 1px); }
    91% { opacity: 1; clip-path: inset(5% 0 70% 0); transform: translate(-5px, 0); }
    93% { opacity: 1; clip-path: inset(66% 0 6% 0); transform: translate(3px, -1px); }
    95% { opacity: 1; clip-path: inset(20% 0 55% 0); transform: translate(-3px, 0); }
    97% { opacity: 1; clip-path: inset(85% 0 0 0); transform: translate(2px, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-role,
    .hero-role::before,
    .hero-role::after {
      animation: none;
    }
  }
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    list-style: none;
    margin: clamp(20px, 3vw, 40px) 0 0;
    padding: 0;
  }

  .hero-grid :global(.hero-portrait) {
    max-width: 540px;
    justify-self: center;
  }

  .hero-intro {
    max-width: 46ch;
    margin: clamp(20px, 2.6vw, 32px) 0 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  /* Slightly see-through when the ink background runs: ink glows through like ink in dark water. */
  /* Ink running: the canvas paints true black + neon ink inside this shape (data-ink-dark). */
  :global(html.ink-bg-on) .band-ink {
    background: transparent;
  }
  /* while the moon window opens (a circle) the band paints its own solid black */
  :global(html.ink-bg-on) .band[data-opening] .band-ink {
    background: var(--ink);
  }
  /* Black disc around the moon while it peeks out of the hero (can extend above
     the band's top edge); sized and moved by home-motion.ts, fades as the window opens. */
  .band-disc {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 0;
    border-radius: 50%;
    background: var(--ink);
    pointer-events: none;
  }
  /* Moon loop (Praveen's video) on the right of the statement, at its own speed. */
  .band-moon {
    position: absolute;
    right: max(4vw, 16px);
    top: 50%;
    width: min(38vw, 520px);
    margin-top: calc(min(38vw, 520px) / -2);
    z-index: 0;
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .band-moon {
      position: relative;
      right: auto;
      top: auto;
      /* margin (not padding): the box must be exactly the moon so the circle centres on it */
      margin: 40px auto -12%;
      width: 62vw;
    }
    /* Phones: the band sizes to its content (no full-screen height = no empty black). */
    .band-inner {
      min-height: 0;
      justify-content: flex-start;
      gap: 36px;
      padding-block: 24px 56px;
    }
  }
</style>
