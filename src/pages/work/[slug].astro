---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import SpecList from "../../components/ui/SpecList.astro";
import TagBlock from "../../components/ui/TagBlock.astro";
import LinkButton from "../../components/ui/LinkButton.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout title={d.title} section="/work" description={d.summary}>
  <PageHeader section="/work" title={d.title} lead={d.summary} />

  {
    d.cover && (
      <figure class="frame cover">
        <Image src={d.cover} alt={d.coverAlt ?? ""} widths={[800, 1400, 2000]} sizes="(min-width: 1440px) 1344px, 94vw" loading="eager" />
      </figure>
    )
  }

  <article class="frame case grid-12">
    <aside class="col-span-4 md:col-span-4 case-aside">
      {(d.client || d.status || d.year || d.role) && (
        <dl class="facts micro">
          {d.client && (<div><dt>Client</dt><dd>{d.client}</dd></div>)}
          {d.role && (<div><dt>Role</dt><dd>{d.role}</dd></div>)}
          {d.year && (<div><dt>Year</dt><dd>{d.year}</dd></div>)}
          {d.status && (<div><dt>Status</dt><dd>{d.status}</dd></div>)}
        </dl>
      )}
      {d.metrics.length > 0 && (
        <div class="metrics">
          {d.metrics.map((m) => (
            <div class="metric">
              <TagBlock size="lg">{m.value}</TagBlock>
              <span class="micro text-muted">{m.label}</span>
            </div>
          ))}
        </div>
      )}
      <SpecList title="Stack" items={d.stack.map((s, i) => ({ label: String(i + 1).padStart(2, "0"), value: s }))} />
      <div class="links">
        {d.links.demo && <LinkButton href={d.links.demo} external>{d.category === "ml" ? "Live demo" : "Visit site"}</LinkButton>}
        {d.links.code && <LinkButton href={d.links.code} variant="outline" external>Source</LinkButton>}
      </div>
    </aside>

    <div class="col-span-4 md:col-span-7 md:col-start-6 case-body">
      <h2 class="micro text-muted">What was built</h2>
      <div class="prose-body">
        <Content />
      </div>
    </div>
  </article>

  {
    d.modules.length > 0 && (
      <section class="frame modules" aria-labelledby="modules-title">
        <div class="modules-head micro">
          <h2 id="modules-title">The system — {d.modules.length} parts</h2>
          <span class="text-muted">Walkthrough videos per part</span>
        </div>
        {d.modules.map((m, i) => (
          <article class:list={["module grid-12", { flip: i % 2 === 1 }]}>
            <div class="col-span-4 md:col-span-5 module-copy">
              <p class="micro module-kind">
                <span>{String(i + 1).padStart(2, "0")}</span> {m.kind}
              </p>
              <h3 class="display module-name">{m.name}</h3>
              <p class="module-summary">{m.summary}</p>
              {m.points.length > 0 && (
                <ul class="module-points">
                  {m.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )}
              {m.status && <p class="micro module-status">{m.status}</p>}
            </div>
            <div class:list={["col-span-4 md:col-span-7 module-media", m.frame]}>
              {m.video ? (
                <video src={m.video} poster={m.poster?.src} controls muted playsinline preload="metadata" aria-label={`${m.name} walkthrough`} />
              ) : m.poster ? (
                <Image src={m.poster} alt={m.posterAlt ?? m.name} widths={[500, 900, 1400]} sizes="(min-width: 768px) 55vw, 94vw" loading="lazy" />
              ) : (
                <div class="module-soon" role="img" aria-label={`${m.name} walkthrough video coming soon`}>
                  <span class="soon-play" aria-hidden="true">▶</span>
                  <span class="micro">Walkthrough video — coming soon</span>
                </div>
              )}
              {!m.video && m.poster && <span class="micro media-note">Walkthrough video coming soon</span>}
            </div>
          </article>
        ))}
      </section>
    )
  }

  {
    d.gallery.length > 0 && (
      <section class="frame gallery" aria-label="Gallery">
        {d.gallery.map((g, i) => (
          <figure class:list={["shot", { tall: g.src.height > g.src.width }]}>
            <Image src={g.src} alt={g.alt} widths={[600, 1000, 1400]} sizes="(min-width: 768px) 45vw, 94vw" loading="lazy" />
            <figcaption class="micro text-muted">Fig. {String(i + 1).padStart(2, "0")} — {g.alt}</figcaption>
          </figure>
        ))}
      </section>
    )
  }

  <nav class="frame next" aria-label="Next project">
    <a href={`/work/${next.id}`} class="next-link">
      <span class="micro text-muted">Next project</span>
      <span class="display next-title ink-text">{next.data.title}</span>
    </a>
  </nav>
</BaseLayout>

<style>
  .cover {
    margin: 0 auto clamp(40px, 5vw, 72px);
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .facts {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .facts div {
    display: grid;
    gap: 4px;
  }
  .facts dt {
    color: var(--fg-muted);
  }
  .facts dd {
    margin: 0;
    color: var(--fg);
    font-weight: 700;
  }
  .prose-body :global(p) {
    margin: 0 0 1.1em;
    font-size: var(--text-lead);
    line-height: 1.5;
    max-width: 62ch;
  }
  .prose-body :global(p strong) {
    display: block;
    margin-top: 1.6em;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .prose-body :global(ul + p) {
    margin-top: 0.4em;
  }
  .gallery {
    display: grid;
    gap: 24px;
    padding-bottom: clamp(48px, 8vw, 128px);
  }
  @media (min-width: 768px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  .shot {
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .shot.tall :global(img) {
    max-height: 760px;
    width: auto;
    margin-inline: auto;
  }
  .case {
    row-gap: 48px;
    padding-bottom: clamp(48px, 8vw, 128px);
    border-top: 1px solid var(--line-strong);
    padding-top: 40px;
  }
  .case-aside {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .metrics {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .metric {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .case-body h2 {
    margin: 0 0 16px;
  }
  .prose-body :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: item;
  }
  .prose-body :global(li) {
    counter-increment: item;
    display: grid;
    grid-template-columns: 48px 1fr;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-lead);
    line-height: 1.45;
  }
  .prose-body :global(li)::before {
    content: counter(item, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--fg-muted);
    padding-top: 0.5em;
  }
  .next {
    border-top: 1px solid var(--line-strong);
  }
  .next-link {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: clamp(40px, 6vw, 96px);
  }
  .next-title {
    font-size: clamp(3rem, 1rem + 8vw, 9rem);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .next-link:hover .next-title {
    transform: translateX(24px);
  }
  /* System parts (e.g. RTCOM apps): copy beside a media slot (video / screenshot / coming soon). */
  .modules {
    padding-bottom: clamp(48px, 7vw, 112px);
  }
  .modules-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .modules-head h2 {
    font: inherit;
    margin: 0;
  }
  .module {
    row-gap: 24px;
    padding-block: clamp(36px, 5vw, 72px);
    border-bottom: 1px solid var(--line);
    align-items: center;
  }
  @media (min-width: 768px) {
    .module.flip .module-copy {
      order: 2;
      grid-column: 8 / span 5;
    }
    .module.flip .module-media {
      order: 1;
      grid-column: 1 / span 7;
    }
  }
  .module-kind {
    margin: 0 0 10px;
    color: var(--fg-muted);
  }
  .module-kind span {
    color: var(--accent-as-text);
    margin-right: 8px;
  }
  .module-name {
    margin: 0;
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.4rem);
  }
  .module-summary {
    margin: 14px 0 0;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--fg-muted);
  }
  .module-points {
    margin: 18px 0 0;
    padding-left: 1.1em;
    display: grid;
    gap: 8px;
  }
  .module-status {
    margin: 18px 0 0;
    display: inline-block;
    padding: 6px 10px;
    border: 1px solid var(--line-strong);
  }
  .module-media {
    position: relative;
  }
  .module-media :global(img),
  .module-media video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--ink);
  }
  .module-media.phone :global(img),
  .module-media.phone video {
    width: auto;
    max-width: 100%;
    max-height: 640px;
    margin-inline: auto;
    border-radius: 28px;
  }
  .media-note {
    display: block;
    margin-top: 10px;
    color: var(--fg-muted);
    text-align: center;
  }
  .module-soon {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
    border-radius: 16px;
    border: 1px dashed var(--line-strong);
    background: color-mix(in oklab, var(--fg) 4%, transparent);
    color: var(--fg-muted);
  }
  .module-media.phone .module-soon {
    aspect-ratio: 9 / 16;
    max-height: 560px;
    margin-inline: auto;
    border-radius: 28px;
  }
  .soon-play {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 22px;
    padding-left: 4px;
  }
</style>
