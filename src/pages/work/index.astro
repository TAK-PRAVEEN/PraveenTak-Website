---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import GlassFolder from "../../components/ui/GlassFolder.astro";
import GlassPreview from "../../components/ui/GlassPreview.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const GROUPS = [
  { key: "client", label: "Client systems", note: "Built for businesses, in production" },
  { key: "product", label: "Products", note: "My own products in development" },
  { key: "ml", label: "AI / ML projects", note: "Models, tools and applications" },
] as const;
// Header stats + marquee, all derived from content.
const stack = [...new Set(projects.flatMap((p) => p.data.stack.map((s) => s.split(/[ (/]/)[0])))].filter((s) => s.length > 1);
const stats = [
  { value: String(projects.length), label: "Projects" },
  { value: String(projects.filter((p) => p.data.category === "client").length), label: "Client systems" },
  { value: String(projects.filter((p) => /live|deployed/i.test(p.data.status ?? "")).length), label: "Live / deployed" },
  { value: `${stack.length}+`, label: "Technologies" },
];
let n = 0;
const groups = GROUPS.map((g) => ({ ...g, items: projects.filter((p) => p.data.category === g.key).map((p) => ({ p, i: ++n })) })).filter(
  (g) => g.items.length > 0,
);
---

<BaseLayout title="Work" fullTitle="Projects — AI/ML, Flutter & Web Systems by Praveen Tak" section="/work" description="Selected work by Praveen Tak: the RTCOM operating system for DESIGO® Milk, client websites, products in development and AI/ML projects with real results.">
  <PageHeader section="/work" title="Selected work" lead="Client systems in production, products in development, and machine-learning work — from model to deployment.">
    <dl slot="below" class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dd class="numeral">{s.value}</dd>
          <dt class="hud">{s.label}</dt>
        </div>
      ))}
    </dl>
  </PageHeader>

  <div class="marquee" aria-label="Technologies used across projects">
    <div class="marquee-track">
      {[0, 1].map((k) => (
        <ul class="hud" aria-hidden={k === 1 ? "true" : undefined}>
          {stack.map((s) => <li>{s}</li>)}
        </ul>
      ))}
    </div>
  </div>

  {
    groups.map((g) => (
      <section class="frame group" aria-labelledby={`g-${g.key}`}>
        <div class="group-head micro">
          <h2 id={`g-${g.key}`} data-decode>{g.label}</h2>
          <span class="text-muted" data-decode>{g.note}</span>
        </div>
        <ol class="folders">
          {g.items.map(({ p, i }) => (
            <li>
              <GlassFolder
                href={`/work/${p.id}`}
                kicker={`P—${String(i).padStart(2, "0")}${p.data.client ? ` · ${p.data.client}` : ""}`}
                title={p.data.title}
                meta={p.data.status}
                note={p.data.summary}
                cover={p.data.cover}
                seed={i}
              />
            </li>
          ))}
        </ol>
      </section>
    ))
  }
  {import.meta.env.DEV && <GlassPreview />}
</BaseLayout>

<style>
  .folders {
    list-style: none;
    margin: 0 0 clamp(48px, 6vw, 96px);
    padding: 24px 0 0;
    display: grid;
    gap: clamp(28px, 3.5vw, 56px) clamp(20px, 2.5vw, 40px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 0;
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, max-content));
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
    padding-left: 14px;
    border-left: 1px solid var(--line-strong);
  }
  .stat dd {
    margin: 0;
    font-size: clamp(2.2rem, 1.4rem + 2.2vw, 3.6rem);
  }
  .stat dt {
    color: var(--fg-muted);
    font-size: 9px;
  }
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    margin-bottom: clamp(40px, 6vw, 80px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee ul {
    display: flex;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 16px 20px;
  }
  .marquee li::before {
    content: "◆ ";
    color: var(--accent);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .group {
    padding-bottom: clamp(48px, 6vw, 96px);
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .group-head h2 {
    font: inherit;
    margin: 0;
  }
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project {
    position: relative;
    row-gap: 16px;
    padding-block: clamp(28px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0 0 12px;
  }
  .project-title {
    font-size: var(--text-h2);
    margin: 0;
    transition: transform var(--dur) var(--ease-out);
  }
  .project:hover .project-title {
    transform: translateX(12px);
  }
  .project-summary {
    margin: 12px 0 0;
    max-width: 52ch;
    color: var(--fg-muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    color: var(--fg-muted);
  }
  .project-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  /* Covers stay monochrome (Swiss discipline) until the row is hovered or focused. */
  .project-side :global(.cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter var(--dur-slow) var(--ease-out);
  }
  .project:is(:hover, :focus-visible) .project-side :global(.cover) {
    filter: none;
  }
  .project :global(.project-arrow) {
    position: absolute;
    top: clamp(28px, 4vw, 56px);
    right: 0;
    transition: transform var(--dur) var(--ease-out);
  }
  .project:hover :global(.project-arrow) {
    transform: rotate(45deg);
  }
  @media (min-width: 768px) {
    .project :global(.project-arrow) {
      display: none;
    }
    .project:not(:has(.cover)) :global(.project-arrow) {
      display: block;
    }
  }
  @media (max-width: 767px) {
    .project > :global(*) {
      grid-column: 1 / -1 !important;
    }
    .project :global(h2),
    .project :global(h3) {
      padding-right: 40px;
      overflow-wrap: anywhere;
      font-size: clamp(2rem, 9vw, 2.6rem);
    }
  }
</style>
