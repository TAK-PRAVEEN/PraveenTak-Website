---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import TagBlock from "../../components/ui/TagBlock.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const GROUPS = [
  { key: "client", label: "Client systems", note: "Built for businesses, in production" },
  { key: "product", label: "Products", note: "My own products in development" },
  { key: "ml", label: "AI / ML projects", note: "Models, tools and applications" },
] as const;
// Header stats + marquee, all derived from content.
const stack = [...new Set(projects.flatMap((p) => p.data.stack.map((s) => s.split(/[ (/]/)[0])))].filter((s) => s.length > 1);
const stats = [
  { value: String(projects.length), label: "Projects" },
  { value: String(projects.filter((p) => p.data.category === "client").length), label: "Client systems" },
  { value: String(projects.filter((p) => /live|deployed/i.test(p.data.status ?? "")).length), label: "Live / deployed" },
  { value: `${stack.length}+`, label: "Technologies" },
];
// Hover previews: small optimised covers that follow the cursor.
const previews = Object.fromEntries(
  await Promise.all(
    projects.filter((p) => p.data.cover).map(async (p) => [p.id, (await getImage({ src: p.data.cover!, width: 520, format: "webp" })).src] as const),
  ),
);
let n = 0;
const groups = GROUPS.map((g) => ({ ...g, items: projects.filter((p) => p.data.category === g.key).map((p) => ({ p, i: ++n })) })).filter(
  (g) => g.items.length > 0,
);
---

<BaseLayout title="Work" section="/work" description="Selected client systems, products and AI/ML projects by Praveen Tak.">
  <PageHeader section="/work" title="Selected work" lead="Client systems in production, products in development, and machine-learning work — from model to deployment.">
    <dl slot="below" class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dd class="numeral">{s.value}</dd>
          <dt class="hud">{s.label}</dt>
        </div>
      ))}
    </dl>
  </PageHeader>

  <div class="marquee" aria-label="Technologies used across projects">
    <div class="marquee-track">
      {[0, 1].map((k) => (
        <ul class="hud" aria-hidden={k === 1 ? "true" : undefined}>
          {stack.map((s) => <li>{s}</li>)}
        </ul>
      ))}
    </div>
  </div>

  <img class="preview" src="" alt="" aria-hidden="true" data-preview-img />

  {
    groups.map((g) => (
      <section class="frame group" aria-labelledby={`g-${g.key}`}>
        <div class="group-head micro">
          <h2 id={`g-${g.key}`} data-decode>{g.label}</h2>
          <span class="text-muted" data-decode>{g.note}</span>
        </div>
        <ol class="projects">
          {g.items.map(({ p, i }) => (
            <li>
              <a href={`/work/${p.id}`} class="project grid-12" data-liquid data-preview={previews[p.id]}>
                <span class="micro text-muted col-span-1">P—{String(i).padStart(2, "0")}</span>
                <div class="col-span-3 md:col-span-6">
                  {(p.data.client || p.data.status) && (
                    <p class="micro meta">
                      {p.data.client && <span>{p.data.client}</span>}
                      {p.data.status && <span class="text-muted">{p.data.status}</span>}
                    </p>
                  )}
                  <h3 class="heading project-title">{p.data.title}</h3>
                  <p class="project-summary">{p.data.summary}</p>
                  <ul class="stack">
                    {p.data.stack.slice(0, 5).map((s) => (
                      <li class="micro">{s}</li>
                    ))}
                  </ul>
                </div>
                <div class="col-span-4 md:col-span-4 project-side">
                  {p.data.cover ? (
                    <Image src={p.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 768px) 30vw, 90vw" class="cover" loading="lazy" />
                  ) : (
                    p.data.metrics[0] && (
                      <>
                        <TagBlock size="lg">{p.data.metrics[0].value}</TagBlock>
                        <span class="micro text-muted">{p.data.metrics[0].label}</span>
                      </>
                    )
                  )}
                </div>
                <ArrowUpRight class="project-arrow" size={32} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>

<script>
  // Cover preview follows the cursor over project rows (mouse only).
  document.addEventListener("astro:page-load", () => {
    const img = document.querySelector<HTMLImageElement>("[data-preview-img]");
    if (!img || !matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0, on = false;
    const loop = () => {
      x += (tx - x) * 0.14;
      y += (ty - y) * 0.14;
      img.style.transform = `translate3d(${x + 28}px, ${y - 120}px, 0) rotate(${(tx - x) * 0.03}deg)`;
      raf = on || Math.abs(tx - x) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    document.querySelectorAll<HTMLElement>("[data-preview]").forEach((row) => {
      row.addEventListener("pointerenter", (e) => {
        img.src = row.dataset.preview!;
        x = tx = e.clientX;
        y = ty = e.clientY;
        on = true;
        img.classList.add("on");
        if (!raf) raf = requestAnimationFrame(loop);
      });
      row.addEventListener("pointermove", (e) => ((tx = e.clientX), (ty = e.clientY)));
      row.addEventListener("pointerleave", () => {
        on = false;
        img.classList.remove("on");
      });
    });
  });
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 0;
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, max-content));
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
    padding-left: 14px;
    border-left: 1px solid var(--line-strong);
  }
  .stat dd {
    margin: 0;
    font-size: clamp(2.2rem, 1.4rem + 2.2vw, 3.6rem);
  }
  .stat dt {
    color: var(--fg-muted);
    font-size: 9px;
  }
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    margin-bottom: clamp(40px, 6vw, 80px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee ul {
    display: flex;
    gap: 40px;
    list-style: none;
    margin: 0;
    padding: 16px 20px;
  }
  .marquee li::before {
    content: "◆ ";
    color: var(--accent);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 30;
    width: 280px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 12px;
    pointer-events: none;
    opacity: 0;
    scale: 0.9;
    transition:
      opacity 0.3s var(--ease-out),
      scale 0.4s var(--ease-out);
    box-shadow: 0 24px 50px -24px rgb(0 0 0 / 0.5);
  }
  .preview:global(.on) {
    opacity: 1;
    scale: 1;
  }
  .group {
    padding-bottom: clamp(48px, 6vw, 96px);
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line-strong);
  }
  .group-head h2 {
    font: inherit;
    margin: 0;
  }
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project {
    position: relative;
    row-gap: 16px;
    padding-block: clamp(28px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0 0 12px;
  }
  .project-title {
    font-size: var(--text-h2);
    margin: 0;
    transition: transform var(--dur) var(--ease-out);
  }
  .project:hover .project-title {
    transform: translateX(12px);
  }
  .project-summary {
    margin: 12px 0 0;
    max-width: 52ch;
    color: var(--fg-muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    color: var(--fg-muted);
  }
  .project-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  /* Covers stay monochrome (Swiss discipline) until the row is hovered or focused. */
  .project-side :global(.cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter var(--dur-slow) var(--ease-out);
  }
  .project:is(:hover, :focus-visible) .project-side :global(.cover) {
    filter: none;
  }
  .project :global(.project-arrow) {
    position: absolute;
    top: clamp(28px, 4vw, 56px);
    right: 0;
    transition: transform var(--dur) var(--ease-out);
  }
  .project:hover :global(.project-arrow) {
    transform: rotate(45deg);
  }
  @media (min-width: 768px) {
    .project :global(.project-arrow) {
      display: none;
    }
    .project:not(:has(.cover)) :global(.project-arrow) {
      display: block;
    }
  }
  @media (max-width: 767px) {
    .project > :global(*) {
      grid-column: 1 / -1 !important;
    }
    .project :global(h2),
    .project :global(h3) {
      padding-right: 40px;
      overflow-wrap: anywhere;
      font-size: clamp(2rem, 9vw, 2.6rem);
    }
  }
</style>
