---
import { getCollection } from "astro:content";
import GlassFolder from "../../components/ui/GlassFolder.astro";
import GlassPreview from "../../components/ui/GlassPreview.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import EmptyChapter from "../../components/layout/EmptyChapter.astro";
import RefSequence from "../../components/3d/RefSequence.astro";
import { month } from "../../lib/format";

const entries = (await getCollection("lab")).sort((a, b) => a.data.order - b.data.order);

const AREAS = [
  { key: "generative", label: "Generative models" },
  { key: "vision", label: "Computer vision" },
  { key: "llm-agents", label: "LLMs & agentic systems" },
  { key: "research", label: "Research & benchmarks" },
] as const;
const areaLabel = (k: string) => AREAS.find((a) => a.key === k)?.label ?? "Other";
const covered = new Set(entries.map((e) => e.data.area));
const planned = AREAS.filter((a) => !covered.has(a.key)).map((a, i) => ({ code: `L—${String(entries.length + i + 1).padStart(2, "0")}`, label: a.label }));
---

<BaseLayout title="AI / ML Lab" fullTitle="AI/ML Lab — Computer Vision & GAN Research by Praveen Tak" section="/lab" description="AI and machine-learning research by Praveen Tak: computer vision for milk testing, face-recognition attendance, PPE detection and GAN studies.">
  <PageHeader section="/lab" title="AI / ML Lab" lead="Research and experiments in generative models, computer vision and agentic systems."><RefSequence slot="visual" name="brain" frames={107} fps={15} /></PageHeader>

  {
    entries.length > 0 && (
      <section class="frame" aria-label="Lab entries">
        <ol class="folders">
          {entries.map((e, i) => (
            <li>
              <GlassFolder
                href={`/lab/${e.id}`}
                tone="dark"
                kicker={`L—${String(i + 1).padStart(2, "0")} · ${areaLabel(e.data.area)}`}
                title={e.data.title}
                meta={[month(e.data.date), e.data.context].filter(Boolean).join(" · ")}
                note={e.data.summary}
                cover={e.data.figure}
                coverAlt={e.data.figureAlt ?? ""}
                badge={e.data.metrics[0] ? `${e.data.metrics[0].value} ${e.data.metrics[0].label}` : undefined}
                seed={i + 1}
              />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    planned.length > 0 && (
      <EmptyChapter areas={planned} note="More notebooks are being written up — these areas land next." />
    )
  }
  {import.meta.env.DEV && <GlassPreview />}
</BaseLayout>

<style>
  .folders {
    list-style: none;
    margin: 0 0 clamp(48px, 6vw, 96px);
    padding: 24px 0 0;
    display: grid;
    gap: clamp(28px, 3.5vw, 56px) clamp(20px, 2.5vw, 40px);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .entries {
    list-style: none;
    margin: 0 0 clamp(48px, 6vw, 96px);
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }
  .entry {
    position: relative;
    row-gap: 16px;
    padding-block: clamp(28px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur) var(--ease-out);
  }
  .entry:hover {
    background: color-mix(in oklab, var(--accent) 7%, transparent);
  }
  .code {
    color: var(--accent-as-text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0 0 12px;
    color: var(--fg-muted);
  }
  .area {
    color: var(--accent-as-text);
  }
  .title {
    font-size: var(--text-h2);
    margin: 0;
  }
  .summary {
    margin: 14px 0 0;
    max-width: 56ch;
    color: var(--fg-muted);
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    align-self: end;
  }
  .value {
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 4rem);
    color: var(--accent-as-text);
  }
  .label {
    color: var(--fg-muted);
  }
  .entry :global(.arrow) {
    position: absolute;
    top: clamp(28px, 4vw, 56px);
    right: 0;
    transition: transform var(--dur) var(--ease-out);
  }
  .entry:hover :global(.arrow) {
    transform: rotate(45deg);
  }
  @media (max-width: 767px) {
    .entry > :global(*) {
      grid-column: 1 / -1 !important;
    }
    .entry :global(h2),
    .entry :global(h3) {
      padding-right: 40px;
      overflow-wrap: anywhere;
      font-size: clamp(2rem, 9vw, 2.6rem);
    }
  }
</style>
