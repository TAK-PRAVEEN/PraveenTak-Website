---
/**
 * Root layout for every page.
 * Sets surface (paper | ink) and accent per experience — DESIGN.md §2–3.
 */
import "../styles/global.css";
import { getCollection, getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";
import OrbCursor from "../components/3d/OrbCursor.astro";
import LiquidFX from "../components/motion/LiquidFX.astro";
import TextFX from "../components/motion/TextFX.astro";
import Hud from "../components/layout/Hud.astro";
import CommandPalette from "../components/layout/CommandPalette.astro";
import InkBackground from "../components/3d/InkBackground.astro";
import InkNav from "../components/motion/InkNav.astro";
import ChatBot from "../components/layout/ChatBot.astro";
import FaviconFX from "../components/motion/FaviconFX.astro";
import { SITE, experienceFor, type Accent, type Surface } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Route of the experience this page belongs to; drives surface + accent. */
  section?: string;
  surface?: Surface;
  accent?: Accent;
  /** Hide the footer (e.g. on a full-bleed experience). */
  bare?: boolean;
  /** Keep this page out of search engines (internal tools such as /playground). */
  noindex?: boolean;
  /** Full <title> override (otherwise "title — Praveen Tak"). */
  fullTitle?: string;
  /** Extra schema.org object for this page (e.g. a project or article), added to the JSON-LD graph. */
  schema?: Record<string, unknown>;
  /** Share-card image for this page (root-relative path, 1200x630). Keep it under ~300 KB so WhatsApp shows it. */
  ogImage?: string;
  ogImageAlt?: string;
}

const { title, description = SITE.description, section = Astro.url.pathname, bare = false, noindex = false } = Astro.props;
const exp = experienceFor("/" + (section.split("/")[1] ?? ""));
const surface = Astro.props.surface ?? exp.surface;
const accent = Astro.props.accent ?? exp.accent;

const pageTitle = Astro.props.fullTitle ?? (title ? `${title} — ${SITE.name}` : SITE.title);
// Search engines show ~155 characters: trim longer summaries on a word boundary.
const metaDescription = description.length > 158 ? description.slice(0, 155).replace(/\s+\S*$/, "") + "…" : description;
// Pages are built as about.html etc. but served as /about: canonical URLs drop ".html".
const canonical = new URL(Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, ""), Astro.site ?? SITE.url);
// JPEG, not PNG: WhatsApp drops link previews whose image is larger than ~300 KB.
const ogImage = new URL(Astro.props.ogImage ?? "/og.jpg", Astro.site ?? SITE.url);
const ogImageAlt = Astro.props.ogImageAlt ?? "Praveen Tak — Portfolio. A laptop showing praveentak.dev: websites, AI / ML systems, branding and motion.";

// Structured data (schema.org): who Praveen is, the site, and — per page — what it shows.
const origin = (Astro.site ?? new URL(SITE.url)).origin;
const profile = (await getEntry("profile", "main"))!.data;
const currentRole = (await getCollection("experience", (e) => e.data.kind === "work" && !e.data.end))[0]?.data;
const school = (await getCollection("experience", (e) => e.data.kind === "education")).map((e) => e.data.org);
const personId = `${origin}/#person`;
const graph: Record<string, unknown>[] = [
  {
    "@type": "Person",
    "@id": personId,
    name: profile.name,
    url: `${origin}/`,
    image: `${origin}/og.jpg`,
    email: `mailto:${profile.contact.email}`,
    jobTitle: currentRole?.title ?? profile.roles[0],
    ...(currentRole && { worksFor: { "@type": "Organization", name: currentRole.org.replace("®", "").trim() } }),
    alumniOf: school.map((name) => ({ "@type": "EducationalOrganization", name })),
    address: { "@type": "PostalAddress", addressLocality: profile.location.city, addressRegion: profile.location.region, addressCountry: "IN" },
    knowsAbout: profile.skills.flatMap((g) => g.items).slice(0, 20),
    sameAs: profile.socials.map((s) => s.href),
    description: profile.intro,
  },
  { "@type": "WebSite", "@id": `${origin}/#website`, url: `${origin}/`, name: SITE.name, inLanguage: "en-IN", publisher: { "@id": personId } },
  // Home and About are Google "ProfilePage"s (eligible for the profile rich result); others are plain WebPages.
  ["/", "/about"].includes(String(canonical.pathname).replace(/\/$/, "") || "/")
    ? { "@type": "ProfilePage", "@id": `${canonical}#page`, url: String(canonical), name: pageTitle, description: metaDescription, isPartOf: { "@id": `${origin}/#website` }, mainEntity: { "@id": personId } }
    : { "@type": "WebPage", "@id": `${canonical}#page`, url: String(canonical), name: pageTitle, description: metaDescription, isPartOf: { "@id": `${origin}/#website` }, about: { "@id": personId } },
];
if (Astro.props.schema) graph.push({ author: { "@id": personId }, ...Astro.props.schema });
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\u003c");
// The service worker only runs in production builds (never against the dev server).
const registerSW = import.meta.env.PROD;
---

<!doctype html>
<html lang="en" data-surface={surface} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
    {!noindex && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={surface === "ink" ? "#080809" : "#f0f0ee"} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/icons/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/inter-tight-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Theme before first paint (no flash): the visitor's stored choice, else light (the brand default). -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = "light";
        document.documentElement.dataset.theme = t;
        if (!window.__themeSwap) {
          window.__themeSwap = true;
          // ClientRouter replaces <html> attributes on navigation: carry the theme across.
          document.addEventListener("astro:before-swap", function (e) {
            var cur = document.documentElement, next = e.newDocument.documentElement;
            next.dataset.theme = cur.dataset.theme;
            // Runtime switches set by persisted islands must survive the <html> swap.
            ["ink-bg-on", "orb-on", "ink-nav", "lenis", "lenis-smooth", "lenis-stopped"].forEach(function (c) {
              if (cur.classList.contains(c)) next.classList.add(c);
            });
          });
        }
      })();
    </script>
    <ClientRouter fallback="swap" />
    {registerSW && <script is:inline>if ("serviceWorker" in navigator) addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));</script>}
    {/* Cloudflare Web Analytics (cookieless, no personal data). Production only; the token is public.
        "spa": true also counts the client-side page changes made by the view-transition router. */}
    {registerSW && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "83e7903d90b342dbbba54e53111751de", "spa": true}'></script>
    )}
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <!-- tears the edge of the link-hover ink (global.css "Ink hover on links") -->
      <filter id="ink-link" x="-10%" y="-30%" width="120%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="3" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="9" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <InkBackground />
    <a href="#main" class="skip-link micro">Skip to content</a>
    <Nav current={exp.href} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <InkNav />
    <LiquidFX />
    <TextFX />
    <Hud />
    <CommandPalette />
    <ChatBot />
    <OrbCursor />
    <FaviconFX />
  </body>
</html>
