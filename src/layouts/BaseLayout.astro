---
/**
 * Root layout for every page.
 * Sets surface (paper | ink) and accent per experience — DESIGN.md §2–3.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";
import OrbCursor from "../components/3d/OrbCursor.astro";
import LiquidFX from "../components/motion/LiquidFX.astro";
import TextFX from "../components/motion/TextFX.astro";
import Hud from "../components/layout/Hud.astro";
import CommandPalette from "../components/layout/CommandPalette.astro";
import InkBackground from "../components/3d/InkBackground.astro";
import InkNav from "../components/motion/InkNav.astro";
import ChatBot from "../components/layout/ChatBot.astro";
import { SITE, experienceFor, type Accent, type Surface } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** Route of the experience this page belongs to; drives surface + accent. */
  section?: string;
  surface?: Surface;
  accent?: Accent;
  /** Hide the footer (e.g. on a full-bleed experience). */
  bare?: boolean;
  /** Keep this page out of search engines (internal tools such as /playground). */
  noindex?: boolean;
}

const { title, description = SITE.description, section = Astro.url.pathname, bare = false, noindex = false } = Astro.props;
const exp = experienceFor("/" + (section.split("/")[1] ?? ""));
const surface = Astro.props.surface ?? exp.surface;
const accent = Astro.props.accent ?? exp.accent;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
---

<!doctype html>
<html lang="en" data-surface={surface} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={surface === "ink" ? "#080809" : "#f0f0ee"} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* og:image is added in Phase 5 once the social preview is designed. */}
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/inter-tight-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-400.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Theme before first paint (no flash): the visitor's stored choice, else light (the brand default). -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = "light";
        document.documentElement.dataset.theme = t;
        if (!window.__themeSwap) {
          window.__themeSwap = true;
          // ClientRouter replaces <html> attributes on navigation: carry the theme across.
          document.addEventListener("astro:before-swap", function (e) {
            var cur = document.documentElement, next = e.newDocument.documentElement;
            next.dataset.theme = cur.dataset.theme;
            // Runtime switches set by persisted islands must survive the <html> swap.
            ["ink-bg-on", "orb-on", "ink-nav", "lenis", "lenis-smooth", "lenis-stopped"].forEach(function (c) {
              if (cur.classList.contains(c)) next.classList.add(c);
            });
          });
        }
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <!-- tears the edge of the link-hover ink (global.css "Ink hover on links") -->
      <filter id="ink-link" x="-10%" y="-30%" width="120%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="3" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="9" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <InkBackground />
    <a href="#main" class="skip-link micro">Skip to content</a>
    <Nav current={exp.href} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <InkNav />
    <LiquidFX />
    <TextFX />
    <Hud />
    <CommandPalette />
    <ChatBot />
    <OrbCursor />
  </body>
</html>
