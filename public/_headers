# Cloudflare static-asset headers.
# The service worker must never be cached, or updates would not reach visitors.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
# "Save contact" on /card: open as a contact, not as text.
/praveen-tak.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="praveen-tak.vcf"
